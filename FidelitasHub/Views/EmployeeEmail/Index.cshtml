@model FidelitasHub.Frontend.ViewModels.Email.SendEmployeeEmailViewModel

@{
    ViewData["Title"] = "Send Email to Employee";
}

<div class="container-fluid mt-4">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                📧 Send Email to Employee
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Preview"
                  asp-controller="EmployeeEmail"
                  method="post">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Employee
                        </label>

                        <select asp-for="EmployeeId"
                                asp-items="Model.Employees"
                                class="form-select">

                            <option value="">
                                -- Select Employee --
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Email Template
                        </label>

                        <select asp-for="EmailTemplateId"
                                asp-items="Model.EmailTemplates"
                                class="form-select">

                            <option value="">
                                -- Select Template --
                            </option>

                        </select>

                    </div>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-primary">

                    Generate Preview

                </button>

            </form>

        </div>

    </div>

</div>