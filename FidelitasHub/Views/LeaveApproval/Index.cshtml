@model IEnumerable<FidelitasHub.Models.LeaveApplication>

@{
    ViewData["Title"] = "Leave Approval";
}

<h3 class="mb-4">Leave Approval</h3>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Employee ID</th>
            <th>From</th>
            <th>To</th>
            <th>Days</th>
            <th>Status</th>
            <th>Team Leader</th>
            <th>Manager</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.EmployeeId</td>

                <td>@item.FromDate.ToShortDateString()</td>

                <td>@item.ToDate.ToShortDateString()</td>

                <td>@item.TotalDays</td>

                <td>@item.Status</td>

                <td>@item.TeamLeaderStatus</td>

                <td>@item.ManagerStatus</td>

                <td>

                    <a asp-action="Approve"
                       asp-route-id="@item.LeaveApplicationId"
                       class="btn btn-success btn-sm">
                        Approve
                    </a>

                    <a asp-action="Reject"
                       asp-route-id="@item.LeaveApplicationId"
                       class="btn btn-danger btn-sm">
                        Reject
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>