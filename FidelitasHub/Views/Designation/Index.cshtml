@model IEnumerable<FidelitasHub.Models.Designation>

@{
    ViewData["Title"] = "Designation Master";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title"><i class="fa-solid fa-briefcase"></i> Designation Master</h1>
        <p class="page-head__sub">Manage job designations</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Add Designation
    </a>
</div>

<div class="stat-grid">
    <a class="stat @(string.IsNullOrEmpty(ViewBag.Status as string) ? "is-active" : "")"
       asp-action="Index" asp-route-searchText="@ViewBag.SearchText">
        <span class="stat__icon"><i class="fa-solid fa-briefcase"></i></span>
        <div class="stat__body"><p class="stat__label">Total</p><p class="stat__value">@ViewBag.TotalDesignations</p></div>
    </a>
    <a class="stat stat--success @(ViewBag.Status == "Active" ? "is-active" : "")"
       asp-action="Index" asp-route-status="Active" asp-route-searchText="@ViewBag.SearchText">
        <span class="stat__icon"><i class="fa-solid fa-circle-check"></i></span>
        <div class="stat__body"><p class="stat__label">Active</p><p class="stat__value">@ViewBag.ActiveDesignations</p></div>
    </a>
    <a class="stat stat--danger @(ViewBag.Status == "Inactive" ? "is-active" : "")"
       asp-action="Index" asp-route-status="Inactive" asp-route-searchText="@ViewBag.SearchText">
        <span class="stat__icon"><i class="fa-solid fa-circle-xmark"></i></span>
        <div class="stat__body"><p class="stat__label">Inactive</p><p class="stat__value">@ViewBag.InactiveDesignations</p></div>
    </a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-sm-6 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-transparent"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="searchText" value="@ViewBag.SearchText" class="form-control" placeholder="Search designation..." />
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Code</th><th>Designation Name</th><th>Description</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-semibold">@item.DesignationCode</span></td>
                            <td>@item.DesignationName</td>
                            <td class="text-muted">@item.Description</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-soft-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.DesignationId" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                                @if (item.IsActive)
                                {
                                    <form asp-action="Disable" asp-route-id="@item.DesignationId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-ban"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Enable" asp-route-id="@item.DesignationId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success"><i class="fa-solid fa-check"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted py-4"><i class="fa-solid fa-inbox fa-lg d-block mb-2"></i>No designations found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
