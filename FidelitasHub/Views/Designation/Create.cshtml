@model FidelitasHub.Models.Designation

@{
    ViewData["Title"] = "Add Designation";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title"><i class="fa-solid fa-plus"></i> Add Designation</h1>
        <p class="page-head__sub">Create a new designation</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="fh-card">
            <div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-briefcase text-primary"></i> Designation Information</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="DesignationName" class="form-label"></label>
                        <input asp-for="DesignationName" class="form-control" placeholder="e.g. Assistant Manager" />
                        <span asp-validation-for="DesignationName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" rows="3" class="form-control" placeholder="Optional description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <hr />
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i> Save Designation</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
