@model FidelitasHub.Models.Designation

@{
    ViewData["Title"] = "Edit Designation";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title"><i class="fa-solid fa-pen-to-square"></i> Edit Designation</h1>
        <p class="page-head__sub">Update designation details</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="fh-card">
            <div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-briefcase text-primary"></i> Designation Information</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="DesignationId" type="hidden" />
                    <input asp-for="DesignationCode" type="hidden" />
                    <input asp-for="CreatedDate" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Designation Code</label>
                        <input class="form-control" value="@Model.DesignationCode" readonly />
                    </div>
                    <div class="mb-3">
                        <label asp-for="DesignationName" class="form-label"></label>
                        <input asp-for="DesignationName" class="form-control" />
                        <span asp-validation-for="DesignationName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active Designation</label>
                    </div>

                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i> Update Designation</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
