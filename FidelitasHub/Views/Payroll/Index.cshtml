@model IEnumerable<FidelitasHub.Models.PayrollCalendar>

@{
    ViewData["Title"] = "Payroll Calendar";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">
            <i class="fa-solid fa-calendar-days"></i>
            Payroll Calendar
        </h1>
        <p class="page-head__sub">
            Salary periods and processing schedule
        </p>
    </div>

    <div>
        <a asp-action="Create"
           class="btn btn-primary">
            <i class="fa-solid fa-plus"></i>
            Add Payroll Cycle
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Payroll Month</th>
                    <th>Period Start</th>
                    <th>Period End</th>
                    <th>Salary Processing</th>
                    <th>Leave Credit</th>
                    <th class="text-end"
                        style="width: 100px;">
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">
                                    @p.PayrollMonth
                                </span>
                            </td>

                            <td>
                                @p.PeriodStart.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @p.PeriodEnd.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @p.SalaryProcessingDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @if (p.IsLeaveCreditProcessed)
                                {
                                    <span class="badge badge-soft-success">
                                        Done
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-warning">
                                        Pending
                                    </span>
                                }
                            </td>

                            <td class="text-end"
                                style="width: 100px; white-space: nowrap;">

                                <a asp-action="Edit"
                                   asp-route-id="@p.PayrollCalendarId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@p.PayrollCalendarId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this payroll cycle?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>

                                </form>

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-muted py-5">

                            <i class="fa-solid fa-calendar-plus fa-2x d-block mb-3"></i>

                            No payroll periods defined yet.

                            <div class="mt-3">
                                <a asp-action="Create"
                                   class="btn btn-primary">
                                    <i class="fa-solid fa-plus"></i>
                                    Add First Payroll Cycle
                                </a>
                            </div>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>