@{
    ViewData["Title"] = "Home";

    var employeeName = Context.Session.GetString("EmployeeName");
}

<div class="container mt-5">

    <div class="text-center">

        <h1 class="display-3 fw-bold text-primary">
            Welcome to Fidelitas Hub
        </h1>

        <h3 class="text-secondary mt-3">
            Integrated Human Resource Management System
        </h3>

        <hr class="w-50 mx-auto my-4" />

        <h2 class="mt-4">
            Welcome,
            <span class="text-primary">
                @employeeName
            </span>
        </h2>

        <p class="lead mt-4">
            Empowering People. Simplifying HR.
        </p>

        <div class="mt-5">

            <i class="fa-solid fa-building fa-6x text-primary"></i>

        </div>

        <p class="text-muted mt-5">
            Use the navigation menu above to access Attendance,
            Leave Management and other modules.
        </p>

    </div>

</div>