@model IEnumerable<string>

@{
    ViewData["Title"] = "Roles";
    var counts = ViewBag.RoleCounts as Dictionary<string, int> ?? new Dictionary<string, int>();

    var descriptions = new Dictionary<string, string>
    {
        ["SuperAdmin"] = "Full system access, including configuration.",
        ["Admin"] = "Manage masters, attendance, leave and reports.",
        ["HR"] = "Employee and leave administration.",
        ["Manager"] = "Approve leave and view team attendance.",
        ["TeamLead"] = "First-level leave approval for the team.",
        ["Employee"] = "Self-service: attendance and leave requests."
    };
    var icons = new Dictionary<string, string>
    {
        ["SuperAdmin"] = "fa-user-shield",
        ["Admin"] = "fa-user-gear",
        ["HR"] = "fa-user-tie",
        ["Manager"] = "fa-user-check",
        ["TeamLead"] = "fa-user-group",
        ["Employee"] = "fa-user"
    };
}

<div class="page-head">
    <div>
        <h1 class="page-head__title"><i class="fa-solid fa-user-shield"></i> Roles</h1>
        <p class="page-head__sub">Access levels and their members</p>
    </div>
</div>

<div class="row g-3">
    @foreach (var role in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="fh-card h-100">
                <div class="card-body d-flex gap-3">
                    <span class="stat__icon"><i class="fa-solid @(icons.TryGetValue(role, out var ic) ? ic : "fa-user")"></i></span>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h2 class="h6 mb-0">@role</h2>
                            <span class="badge badge-soft">@(counts.TryGetValue(role, out var c) ? c : 0) member(s)</span>
                        </div>
                        <p class="text-muted small mb-0">@(descriptions.TryGetValue(role, out var d) ? d : "")</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<p class="text-muted small mt-3">
    <i class="fa-solid fa-circle-info me-1"></i>
    Roles are currently assigned per employee in the Employee master. Editable role management is planned.
</p>
