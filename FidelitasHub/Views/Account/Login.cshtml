@{
    ViewData["Title"] = "Employee Login";
    Layout = "_Layout";
}

<div class="auth">

    <div class="auth__card">

        <div class="auth__head">
            <div class="auth__mark"><i class="fa-solid fa-building-shield"></i></div>
            <h1 class="h4 mb-1">Fidelitas Hub</h1>
            <p class="mb-0" style="color: var(--fh-muted); font-size:.9rem;">
                Employee Attendance &amp; HR System
            </p>
        </div>

        <div class="auth__body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">

                <div class="mb-3">
                    <label class="form-label">Employee Code</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="fa-solid fa-id-badge text-muted"></i>
                        </span>
                        <input type="text"
                               name="employeeCode"
                               class="form-control"
                               placeholder="Enter Employee Code"
                               autofocus
                               required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="fa-solid fa-lock text-muted"></i>
                        </span>
                        <input type="password"
                               name="password"
                               class="form-control"
                               placeholder="Enter Password"
                               required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="fa-solid fa-right-to-bracket me-1"></i>
                    Sign In
                </button>

                <div class="text-center mt-3">
                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="text-warning text-decoration-none">
                        Forgot Password?
                    </a>
                </div>

            </form>

        </div>

        <div class="auth__foot">
            Version 1.0 &nbsp;·&nbsp; © 2026 Fidelitas RCM Pvt. Ltd.
        </div>

    </div>

</div>