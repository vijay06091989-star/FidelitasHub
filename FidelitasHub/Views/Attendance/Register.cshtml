@model List<FidelitasHub.Models.AttendanceRegisterViewModel>

@{
    ViewData["Title"] = "Attendance Register";

    var today = FidelitasHub.Helpers.DateTimeHelper.GetIST().Date;

    var minDate = today.AddDays(-90).ToString("yyyy-MM-dd");
    var maxDate = today.ToString("yyyy-MM-dd");
}

<div class="page-head">
    <div>
        <h1 class="page-head__title"><i class="fa-solid fa-clipboard-list"></i> Attendance Register</h1>
        <p class="page-head__sub">Filter and export attendance records</p>
    </div>
    <span class="badge badge-soft fs-6 px-3 py-2">Total Records: @Model.Count</span>
</div>

<!-- Filters -->
<div class="fh-card mb-4">
    <div class="card-body">
        <form asp-action="Register" method="get">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input type="date" class="form-control" id="fromDate" name="fromDate"
                           value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" min="@minDate" max="@maxDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input type="date" class="form-control" id="toDate" name="toDate"
                           value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" min="@minDate" max="@maxDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Shift</label>
                    <select class="form-select" id="shift" name="shift">
                        <option value="All" selected="@(ViewBag.Shift == "All")">All</option>
                        <option value="General Shift" selected="@(ViewBag.Shift == "General Shift")">General Shift</option>
                        <option value="US Shift" selected="@(ViewBag.Shift == "US Shift")">US Shift</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Employee</label>
                    <input type="text" class="form-control" id="employee" name="employee"
                           value="@ViewBag.Employee" placeholder="Employee code / name" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" id="status" name="status">
                        <option value="All" selected="@(ViewBag.Status == "All")">All</option>
                        <option value="Present" selected="@(ViewBag.Status == "Present")">Present</option>
                        <option value="Present - Late Entry" selected="@(ViewBag.Status == "Present - Late Entry")">Present - Late Entry</option>
                        <option value="Half Day" selected="@(ViewBag.Status == "Half Day")">Half Day</option>
                        <option value="Absent" selected="@(ViewBag.Status == "Absent")">Absent</option>
                    </select>
                </div>
            </div>

            <hr />

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                </button>
                <a asp-controller="Attendance" asp-action="Register" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-eraser me-1"></i> Clear
                </a>
                <button type="submit" class="btn btn-outline-success"
                        formaction="@Url.Action("ExportAttendanceRegisterExcel", "Attendance")" formmethod="get">
                    <i class="fa-solid fa-file-excel me-1"></i> Excel
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled title="Coming in Version 2">
                    <i class="fa-solid fa-file-pdf me-1"></i> PDF
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled title="Coming in Version 2">
                    <i class="fa-solid fa-print me-1"></i> Print
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Code</th>
                    <th>Employee Name</th>
                    <th>Date</th>
                    <th>Shift</th>
                    <th>Punch In</th>
                    <th>Punch Out</th>
                    <th>Worked</th>
                    <th>Break</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    int slNo = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@slNo</td>
                            <td><span class="fw-semibold">@item.EmployeeCode</span></td>
                            <td>@item.EmployeeName</td>
                            <td>@(item.AttendanceDate == DateTime.MinValue ? "--" : item.AttendanceDate.ToString("dd-MMM-yyyy"))</td>
                            <td>@item.Shift</td>
                            <td>@item.PunchIn</td>
                            <td>@item.PunchOut</td>
                            <td>@item.WorkedTime</td>
                            <td>@item.BreakTime</td>
                            <td>
                                @switch (item.AttendanceStatus)
                                {
                                    case "Working":
                                        <span class="badge badge-soft-success">Working</span>
                                        break;
                                    case "On Break":
                                        <span class="badge badge-soft-warning">On Break</span>
                                        break;
                                    case "Present":
                                        <span class="badge badge-soft-success">Present</span>
                                        break;
                                    case "Present - Late Entry":
                                        <span class="badge badge-soft-warning">Late Entry</span>
                                        break;
                                    case "Half Day":
                                        <span class="badge badge-soft">Half Day</span>
                                        break;
                                    case "Absent":
                                        <span class="badge badge-soft-danger">Absent</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">@item.AttendanceStatus</span>
                                        break;
                                }
                            </td>
                        </tr>
                        slNo++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            <i class="fa-solid fa-inbox fa-lg d-block mb-2"></i>
                            No attendance records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
