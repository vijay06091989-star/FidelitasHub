@model List<FidelitasHub.Models.TodayAttendanceViewModel>

@{
    ViewData["Title"] = "Today's Attendance";
    int slNo = 1;
}

<div class="page-head">
    <div>
        <h1 class="page-head__title"><i class="fa-solid fa-calendar-day"></i> Today's Attendance</h1>
        <p class="page-head__sub">Live attendance for <strong>@ViewBag.SelectedShift</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="TodayAttendance" asp-route-shift="General Shift"
           class="btn @(ViewBag.SelectedShift == "General Shift" ? "btn-primary" : "btn-outline-primary")">General Shift</a>
        <a asp-action="TodayAttendance" asp-route-shift="US Shift"
           class="btn @(ViewBag.SelectedShift == "US Shift" ? "btn-primary" : "btn-outline-primary")">US Shift</a>
        <button class="btn btn-outline-secondary" onclick="location.reload();" title="Refresh">
            <i class="fa-solid fa-rotate"></i>
        </button>
    </div>
</div>

<!-- Summary (click a tile to filter) -->
<div class="stat-grid">
    <div class="stat stat--success attendance-card cursor-pointer" data-status="Present">
        <span class="stat__icon"><i class="fa-solid fa-user-check"></i></span>
        <div class="stat__body">
            <p class="stat__label">Present</p><p class="stat__value">
            @Model.Count(x =>
x.Status == "Working" ||
x.Status == "On Break" ||
x.Status == "Punched Out")
        </p>
    </div>
    </div>
    <div class="stat attendance-card cursor-pointer" data-status="Absent">
        <span class="stat__icon"><i class="fa-solid fa-user-xmark"></i></span>
        <div class="stat__body"><p class="stat__label">Absent</p><p class="stat__value">@Model.Count(x => x.Status == "Absent")</p></div>
    </div>
    <div class="stat stat--primary attendance-card cursor-pointer" data-status="Approved Leave">
        <span class="stat__icon">
            <i class="fa-solid fa-calendar-check"></i>
        </span>
        <div class="stat__body">
            <p class="stat__label">Approved Leave</p>
            <p class="stat__value">
                @Model.Count(x => x.IsOnApprovedLeave)
            </p>
        </div>
    </div>
    <div class="stat stat--info attendance-card cursor-pointer" data-status="Working">
        <span class="stat__icon"><i class="fa-solid fa-briefcase"></i></span>
        <div class="stat__body"><p class="stat__label">Working</p><p class="stat__value">@Model.Count(x => x.Status == "Working")</p></div>
    </div>
    <div class="stat stat--secondary attendance-card cursor-pointer" data-status="Idle">
        <span class="stat__icon"><i class="fa-solid fa-hourglass-half"></i></span>
        <div class="stat__body"><p class="stat__label">Idle</p><p class="stat__value">@Model.Count(x => x.CurrentActivity == "Idle")</p></div>
    </div>
    <div class="stat stat--warning attendance-card cursor-pointer" data-status="On Break">
        <span class="stat__icon"><i class="fa-solid fa-mug-hot"></i></span>
        <div class="stat__body"><p class="stat__label">On Break</p><p class="stat__value">@Model.Count(x => x.Status == "On Break")</p></div>
    </div>
    <div class="stat stat--danger attendance-card cursor-pointer" data-status="Punched Out">
        <span class="stat__icon"><i class="fa-solid fa-door-open"></i></span>
        <div class="stat__body"><p class="stat__label">Punched Out</p><p class="stat__value">@Model.Count(x => x.Status == "Punched Out")</p></div>
    </div>
</div>

<!-- Search -->
<form class="mb-3" onsubmit="return false;">
    <div class="row g-2 align-items-center">
        <div class="col-sm-6 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-transparent"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" id="txtSearch" class="form-control" placeholder="Employee code / name" />
            </div>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" id="btnSearch">Search</button>
            <button class="btn btn-outline-secondary" id="btnClear">Clear</button>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="ExportTodayAttendanceExcel" asp-route-shift="@ViewBag.SelectedShift" class="btn btn-outline-success">
                <i class="fa-solid fa-file-excel me-1"></i> Export Excel
            </a>
        </div>
    </div>
</form>

<!-- Table -->
<div class="table-card">
    <div class="table-responsive">
        <table id="attendanceTable" class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="sortable" data-column="0" data-type="number"># <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="1" data-type="text">Code <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="2" data-type="text">Employee Name <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="3" data-type="text">Department <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="4" data-type="text">Shift <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="5" data-type="time">Punch In <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="6" data-type="time">Punch Out <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="7" data-type="time">Break In <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="8" data-type="time">Break Out <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="9" data-type="duration">Total Break <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="10" data-type="duration">Worked <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="11" data-type="text">Current Activity <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="12" data-type="duration">Total Idle <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="13" data-type="text">Attendance Status <span class="sort-indicator"></span></th>
                    <th class="sortable" data-column="14" data-type="text">Leave Status <span class="sort-indicator"></span></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr data-status="@item.Status"
                            data-activity="@item.CurrentActivity"
                            data-sort-code="@item.EmployeeCode"
                            data-sort-name="@item.EmployeeName"
                            data-sort-department="@item.Department"
                            data-sort-shift="@item.Shift"
                            data-sort-punchin="@item.PunchIn"
                            data-sort-punchout="@item.PunchOut"
                            data-sort-breakin="@item.BreakStart"
                            data-sort-breakout="@item.BreakEnd"
                            data-sort-totalbreak="@item.TotalBreak"
                            data-sort-worked="@item.WorkedTime"
                            data-sort-activity="@item.CurrentActivity"
                            data-sort-idle="@item.TotalIdle"
                            data-sort-status="@item.Status"
                            data-sort-leave="@item.LeaveStatus">
                            <td>@slNo</td>
                            <td><span class="fw-semibold">@item.EmployeeCode</span></td>
                            <td>@item.EmployeeName</td>
                            <td>@item.Department</td>
                            <td>@item.Shift</td>
                            <td>@item.PunchIn</td>
                            <td>@item.PunchOut</td>
                            <td>@item.BreakStart</td>
                            <td>@item.BreakEnd</td>
                            <td>@item.TotalBreak</td>
                            <td>@item.WorkedTime</td>
                            <td>
                                @if (item.CurrentActivity == "Idle")
                                {
                                    <span class="badge bg-warning text-dark">Idle</span>
                                }
                                else if (item.CurrentActivity == "Active")
                                {
                                    <span class="badge badge-soft-success">Active</span>
                                }
                                else if (item.CurrentActivity == "On Break")
                                {
                                    <span class="badge badge-soft-warning">On Break</span>
                                }
                                else
                                {
                                    <span class="text-muted">@item.CurrentActivity</span>
                                }
                            </td>
                            <td>@item.TotalIdle</td>
                            <td>
                                @if (item.Status == "Working")
                                {
                                    <span class="badge badge-soft-success">Working</span>
                                }
                                else if (item.Status == "On Break")
                                {
                                    <span class="badge badge-soft-warning">On Break</span>
                                }
                                else if (item.Status == "Punched Out")
                                {
                                    <span class="badge badge-soft-danger">Punched Out</span>
                                }
                                else if (item.Status == "On Leave")
                                {
                                    <span class="badge bg-success">On Leave</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Absent</span>
                                }
                            </td>
                            <td>
                                @if (item.IsOnApprovedLeave)
                                {
                                    <span class="badge bg-success">
                                        @item.LeaveStatus
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">--</span>
                                }
                            </td>
                        </tr>
                        slNo++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="15" class="text-center text-muted py-4">
                            <i class="fa-solid fa-inbox fa-lg d-block mb-2"></i>
                            No attendance records for this shift.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<style>
    #attendanceTable th.sortable {
        user-select: none;
        white-space: nowrap;
    }

    #attendanceTable th.sortable:hover {
        text-decoration: underline;
    }

    #attendanceTable .sort-indicator {
        font-size: 0.75em;
        opacity: 0.75;
    }
</style>

@section Scripts
{
    <script>
        let activeFilter = "";
        let currentSortColumn = -1;
        let currentSortDirection = 1;

        function getRows() {
            return Array.from(document.querySelectorAll("tbody tr[data-status]"));
        }

        function applyFilters() {
            var searchValue = document.getElementById("txtSearch").value.toLowerCase();

            getRows().forEach(function (row) {
                var matchesSearch =
                    row.innerText.toLowerCase().indexOf(searchValue) > -1;

                var matchesCard = true;

                if (activeFilter !== "") {
                    var attendanceStatus = (row.dataset.status || "").toLowerCase();
                    var activity = (row.dataset.activity || "").toLowerCase();
                    var leaveStatus = row.innerText.toLowerCase();

                    if (activeFilter === "present") {
                        matchesCard = attendanceStatus !== "absent";
                    }
                    else if (activeFilter === "approved leave") {
                        matchesCard = leaveStatus.indexOf("approved leave") > -1;
                    }
                    else if (activeFilter === "idle") {
                        matchesCard = activity === "idle";
                    }
                    else {
                        matchesCard =
                            attendanceStatus.indexOf(activeFilter) > -1;
                    }
                }

                row.style.display =
                    matchesSearch && matchesCard ? "" : "none";
            });
        }

        document.getElementById("btnSearch").addEventListener("click", function () {
            applyFilters();
        });

        document.getElementById("btnClear").addEventListener("click", function () {
            document.getElementById("txtSearch").value = "";
            activeFilter = "";

            document.querySelectorAll(".attendance-card")
                .forEach(c => c.classList.remove("is-active"));

            applyFilters();
        });

        document.querySelectorAll(".attendance-card").forEach(function (card) {
            card.addEventListener("click", function () {
                var filter = this.dataset.status.toLowerCase();

                if (activeFilter === filter) {
                    activeFilter = "";
                    document.querySelectorAll(".attendance-card")
                        .forEach(c => c.classList.remove("is-active"));

                    applyFilters();
                    return;
                }

                activeFilter = filter;

                document.querySelectorAll(".attendance-card")
                    .forEach(c => c.classList.remove("is-active"));

                this.classList.add("is-active");

                applyFilters();
            });
        });

        function parseTime(value) {
            if (!value || value === "--") return Number.POSITIVE_INFINITY;

            var match = value.trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
            if (!match) return Number.POSITIVE_INFINITY;

            var hour = parseInt(match[1], 10);
            var minute = parseInt(match[2], 10);
            var ampm = match[3].toUpperCase();

            if (ampm === "AM" && hour === 12) hour = 0;
            if (ampm === "PM" && hour !== 12) hour += 12;

            return (hour * 60) + minute;
        }

        function parseDuration(value) {
            if (!value || value === "--") return Number.POSITIVE_INFINITY;

            var match = value.trim().match(/^(\d+):(\d{2})$/);
            if (!match) return Number.POSITIVE_INFINITY;

            return (parseInt(match[1], 10) * 60) +
                   parseInt(match[2], 10);
        }

        function getSortValue(row, column, type) {
            var values = [
                row.children[0]?.innerText.trim() || "",
                row.dataset.sortCode || "",
                row.dataset.sortName || "",
                row.dataset.sortDepartment || "",
                row.dataset.sortShift || "",
                row.dataset.sortPunchin || "",
                row.dataset.sortPunchout || "",
                row.dataset.sortBreakin || "",
                row.dataset.sortBreakout || "",
                row.dataset.sortTotalbreak || "",
                row.dataset.sortWorked || "",
                row.dataset.sortActivity || "",
                row.dataset.sortIdle || "",
                row.dataset.sortStatus || "",
                row.dataset.sortLeave || ""
            ];

            var value = values[column];

            if (type === "number") {
                return parseInt(value, 10) || 0;
            }

            if (type === "time") {
                return parseTime(value);
            }

            if (type === "duration") {
                return parseDuration(value);
            }

            return value.toLowerCase();
        }

        function sortTable(header) {
            var column = parseInt(header.dataset.column, 10);
            var type = header.dataset.type;

            if (currentSortColumn === column) {
                currentSortDirection *= -1;
            }
            else {
                currentSortColumn = column;
                currentSortDirection = 1;
            }

            var tbody = document.querySelector("#attendanceTable tbody");
            var rows = getRows();

            rows.sort(function (a, b) {
                var valueA = getSortValue(a, column, type);
                var valueB = getSortValue(b, column, type);

                if (valueA < valueB) return -1 * currentSortDirection;
                if (valueA > valueB) return 1 * currentSortDirection;
                return 0;
            });

            rows.forEach(function (row) {
                tbody.appendChild(row);
            });

            // Re-number the visible table rows after sorting.
            rows.forEach(function (row, index) {
                row.children[0].innerText = index + 1;
            });

            document.querySelectorAll(".sort-indicator")
                .forEach(function (indicator) {
                    indicator.innerText = "";
                });

            var indicator = header.querySelector(".sort-indicator");
            indicator.innerText =
                currentSortDirection === 1 ? " ▲" : " ▼";

            applyFilters();
        }

        document.querySelectorAll("#attendanceTable th.sortable")
            .forEach(function (header) {
                header.style.cursor = "pointer";
                header.title = "Click to sort";

                header.addEventListener("click", function () {
                    sortTable(this);
                });
            });

        // Live attendance data refreshes every 30 seconds.
        setTimeout(function () {
            location.reload();
        }, 30000);
    </script>
}
