@model FidelitasHub.Models.AttendanceCorrectionViewModel

@{
    ViewData["Title"] = "Attendance Correction";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title"><i class="fa-solid fa-pen-to-square"></i> Attendance Correction</h1>
        <p class="page-head__sub">Load a record and apply a correction</p>
    </div>
</div>

<form asp-action="AttendanceCorrection" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <!-- Search -->
    <div class="fh-card mb-4">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="fa-solid fa-magnifying-glass text-primary"></i> Find Attendance
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Employee</label>
                    <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select">
                        <option value="">-- Select Employee --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Attendance Date</label>
                    <input asp-for="AttendanceDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-download me-1"></i> Load Attendance
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.EmployeeCode))
    {
        <div class="row g-4">

            <!-- Employee + current attendance -->
            <div class="col-lg-6">
                <div class="fh-card h-100">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="fa-solid fa-id-card text-primary"></i> Employee &amp; Current Record
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Employee Code</label>
                                <input class="form-control" value="@Model.EmployeeCode" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Employee Name</label>
                                <input class="form-control" value="@Model.EmployeeName" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Department</label>
                                <input class="form-control" value="@Model.Department" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Shift</label>
                                <input class="form-control" value="@Model.Shift" readonly />
                            </div>

                            <div class="col-12"><hr class="my-1" /></div>

                            <div class="col-md-3">
                                <label class="form-label">Punch In</label>
                                <input asp-for="PunchIn" class="form-control" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Punch Out</label>
                                <input asp-for="PunchOut" class="form-control" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Break Min</label>
                                <input asp-for="BreakMinutes" class="form-control" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Status</label>
                                <input asp-for="Status" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Correction -->
            <div class="col-lg-6">
                <div class="fh-card h-100">
                    <div class="card-header d-flex align-items-center gap-2">
                        <i class="fa-solid fa-wrench text-primary"></i> Apply Correction
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Correction Type</label>
                            <select asp-for="CorrectionType" class="form-select">
                                <option value="">-- Select Correction Type --</option>
                                <option>Forgot Punch In</option>
                                <option>Forgot Punch Out</option>
                                <option>Wrong Punch Time</option>
                                <option>Wrong Break Time</option>
                            </select>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">New Punch In Time</label>
                                <input asp-for="NewPunchInTime" type="time" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">New Punch Out Time</label>
                                <input asp-for="NewPunchOutTime" type="time" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">New Break Minutes</label>
                                <input asp-for="NewBreakMinutes" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Reason for Correction</label>
                                <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                            </div>
                        </div>

                        <hr />

                        <button type="submit" formaction="@Url.Action("SaveAttendanceCorrection", "Attendance")"
                                class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Correction
                        </button>
                    </div>
                </div>
            </div>

        </div>
    }

</form>
