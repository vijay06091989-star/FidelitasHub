@{
    ViewData["Title"] = "Attendance Dashboard";

    bool canPunchIn = ViewBag.AttendanceStatus == "Not Punched In";
    bool canBreak = ViewBag.AttendanceStatus == "Working";
    bool canResume = ViewBag.AttendanceStatus == "On Break";
    bool canPunchOut = ViewBag.AttendanceStatus == "Working";

    string status = ViewBag.AttendanceStatus as string ?? "Not Punched In";
    string statusBadge = status switch
    {
        "Working" => "badge-soft-success",
        "On Break" => "badge-soft-warning",
        "Punched Out" => "badge-soft-danger",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
    string statusIcon = status switch
    {
        "Working" => "fa-circle-play",
        "On Break" => "fa-mug-hot",
        "Punched Out" => "fa-circle-stop",
        _ => "fa-circle"
    };
}

<div class="page-head">
    <div>
        <h1 class="page-head__title"><i class="fa-solid fa-gauge-high"></i> My Dashboard</h1>
        <p class="page-head__sub">Welcome, <strong>@ViewBag.EmployeeName</strong></p>
    </div>
    <span class="badge @statusBadge fs-6 px-3 py-2">
        <i class="fa-solid @statusIcon me-1"></i> @status
    </span>
</div>

<div class="row g-3">

    <!-- Live clock + actions -->
    <div class="col-lg-5">
        <div class="fh-card h-100">
            <div class="card-body text-center d-flex flex-column">

                <p class="stat__label mb-1">Current IST Time</p>
                <div id="istClock" class="fw-bold text-primary" style="font-size:2.6rem; line-height:1.1; font-variant-numeric:tabular-nums;"></div>
                <p id="istDate" class="text-muted mb-4"></p>

                <div class="mt-auto">
                    <p class="stat__label mb-2">Today's Actions</p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center flex-wrap">
                        <button id="btnPunchIn" class="btn btn-success btn-lg" @(canPunchIn ? "" : "disabled")>
                            <i class="fa-solid fa-circle-play me-1"></i> Punch In
                        </button>
                        <button id="btnBreak" class="btn btn-warning btn-lg" @(canBreak ? "" : "disabled")>
                            <i class="fa-solid fa-mug-hot me-1"></i> Break
                        </button>
                        <button id="btnResume" class="btn btn-info btn-lg" @(canResume ? "" : "disabled")>
                            <i class="fa-solid fa-play me-1"></i> Resume
                        </button>
                        <button id="btnPunchOut" class="btn btn-danger btn-lg" @(canPunchOut ? "" : "disabled")>
                            <i class="fa-solid fa-circle-stop me-1"></i> Punch Out
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Details -->
    <div class="col-lg-7">
        <div class="fh-card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="fa-solid fa-clipboard-list text-primary"></i> Today's Summary
            </div>
            <div class="card-body">
                <table class="table table-borderless align-middle mb-0">
                    <tbody>
                        <tr><td class="text-muted ps-0" style="width:45%;">Shift</td><td class="fw-semibold">@ViewBag.ShiftName</td></tr>
                        <tr><td class="text-muted ps-0">Shift Timing</td><td>@ViewBag.ShiftTiming</td></tr>
                        <tr><td class="text-muted ps-0">Punch In</td><td class="fw-semibold text-success">@ViewBag.PunchInTime</td></tr>
                        <tr><td class="text-muted ps-0">Break Started</td><td class="fw-semibold text-warning">@ViewBag.BreakStartTime</td></tr>
                        <tr><td class="text-muted ps-0">Break Ended</td><td class="fw-semibold text-info">@ViewBag.BreakEndTime</td></tr>
                        <tr><td class="text-muted ps-0">Total Break</td><td class="fw-semibold text-warning">@ViewBag.TotalBreakTime</td></tr>
                        <tr><td class="text-muted ps-0">Worked Time</td><td class="fw-semibold text-primary">@ViewBag.WorkedTime</td></tr>
                        <tr><td class="text-muted ps-0">Punch Out</td><td class="fw-semibold text-danger">@ViewBag.PunchOutTime</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const btnPunchIn = document.getElementById("btnPunchIn");
            const btnBreak = document.getElementById("btnBreak");
            const btnResume = document.getElementById("btnResume");
            const btnPunchOut = document.getElementById("btnPunchOut");

            function updateISTClock() {
                const now = new Date();

                const istTime = now.toLocaleTimeString("en-IN", {
                    timeZone: "Asia/Kolkata",
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit",
                    hour12: true
                });

                const istDate = now.toLocaleDateString("en-IN", {
                    timeZone: "Asia/Kolkata",
                    weekday: "long",
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                });

                document.getElementById("istClock").innerText = istTime;
                document.getElementById("istDate").innerText = istDate;
            }

            updateISTClock();
            setInterval(updateISTClock, 1000);

            function doAction(url, color) {
                fetch(url, { method: "POST" })
                    .then(response => response.json())
                    .then(result => {
                        Swal.fire({
                            icon: result.success ? "success" : "error",
                            title: result.title,
                            html: result.message.replace(/\n/g, "<br>"),
                            confirmButtonColor: color
                        }).then(() => {
                            if (result.success) {
                                location.reload();
                            }
                        });
                    });
            }

            if (btnPunchIn)
                btnPunchIn.addEventListener("click",
                    () => doAction('@Url.Action("PunchIn", "Attendance")', "#16a34a"));

            if (btnBreak)
                btnBreak.addEventListener("click",
                    () => doAction('@Url.Action("Break", "Attendance")', "#d97706"));

            if (btnResume)
                btnResume.addEventListener("click",
                    () => doAction('@Url.Action("Resume", "Attendance")', "#0891b2"));

            if (btnPunchOut)
                btnPunchOut.addEventListener("click",
                    () => doAction('@Url.Action("PunchOut", "Attendance")', "#dc2626"));

        });
    </script>
}