@{
    ViewData["Title"] = "Attendance Dashboard";

    bool canPunchIn =
    ViewBag.CanPunchIn is bool allowed && allowed;

    bool canBreak = ViewBag.AttendanceStatus == "Working";
    bool canResume = ViewBag.AttendanceStatus == "On Break";
    bool canPunchOut = ViewBag.AttendanceStatus == "Working";

    string status = ViewBag.AttendanceStatus as string ?? "Not Punched In";
    string statusBadge = status switch
    {
        "Working" => "badge-soft-success",
        "On Break" => "badge-soft-warning",
        "Punched Out" => "badge-soft-danger",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
    string statusIcon = status switch
    {
        "Working" => "fa-circle-play",
        "On Break" => "fa-mug-hot",
        "Punched Out" => "fa-circle-stop",
        _ => "fa-circle"
    };
}



<div class="fh-dashboard-reference" id="attendance">

    <!-- APPROVED HERO -->
    <section class="fh-hero">
        <div class="fh-hero-main">
            <div class="fh-avatar-xl" id="profileInitials">--</div>
            <div class="fh-hero-copy">
                <div class="fh-greeting">WELCOME BACK</div>
                <h2 id="profileName">Loading profile...</h2>
                <div class="fh-identity" id="profileIdentity">Employee details</div>
                <div class="fh-hero-pills">
                    <span><i class="fa-solid fa-building"></i> <span id="pDepartmentHero">--</span></span>
                    <span><i class="fa-solid fa-calendar-check"></i> <span id="pShiftHero">@ViewBag.ShiftName</span></span>
                    <span><i class="fa-solid fa-id-badge"></i> <span id="pCodeHero">--</span></span>
                </div>
            </div>
        </div>

        <div class="fh-hero-visual">
            <div class="fh-hero-photo"></div>
            <div class="fh-hero-overlay">
                <strong>US Medical Billing &amp; RCM</strong>
                <small>Accurate Billing · Timely Reimbursement · Better Patient Care</small>
            </div>
        </div>
    </section>

    <!-- ATTENDANCE -->
    <section class="fh-main-row">
        <div class="fh-time-card">
            <div class="fh-card-title"><i class="fa-regular fa-clock"></i> Current IST Time</div>
            <div class="fh-big-time" id="istClock">--:--:--</div>
            <div class="fh-date" id="istDate">--</div>
            <div class="fh-time-caption">India Standard Time</div>

            <div class="fh-attendance-actions">
                <button id="btnPunchIn" class="fh-punch punch-in" @(canPunchIn ? "" : "disabled")>
                    <i class="fa-solid fa-play"></i> Punch In
                </button>
                <button id="btnBreak" class="fh-punch break" @(canBreak ? "" : "disabled")>
                    <i class="fa-solid fa-mug-hot"></i> Break
                </button>
                <button id="btnResume" class="fh-punch resume" @(canResume ? "" : "disabled")>
                    <i class="fa-solid fa-play"></i> Resume
                </button>
                <button id="btnPunchOut" class="fh-punch punch-out" @(canPunchOut ? "" : "disabled")>
                    <i class="fa-solid fa-stop"></i> Punch Out
                </button>
            </div>
        </div>

        <div class="fh-summary-card">
            <div class="fh-summary-header">
                <div class="fh-card-title"><i class="fa-regular fa-calendar-check"></i> Today's Summary</div>
                <span class="fh-status" id="attendanceStatus">
                    <i class="fa-solid @statusIcon"></i> @status
                </span>
            </div>

            <div class="fh-summary-grid">
                <div class="fh-stat">
                    <div class="fh-stat-icon shift"><i class="fa-solid fa-building"></i></div>
                    <div><span>Shift</span><strong>@ViewBag.ShiftName</strong><small>@ViewBag.ShiftTiming</small></div>
                </div>
                <div class="fh-stat">
                    <div class="fh-stat-icon in"><i class="fa-solid fa-power-off"></i></div>
                    <div><span>Punch In</span><strong>@ViewBag.PunchInTime</strong></div>
                </div>
                <div class="fh-stat">
                    <div class="fh-stat-icon break"><i class="fa-solid fa-mug-hot"></i></div>
                    <div><span>Break Started</span><strong>@ViewBag.BreakStartTime</strong></div>
                </div>
                <div class="fh-stat">
                    <div class="fh-stat-icon resume"><i class="fa-solid fa-right-to-bracket"></i></div>
                    <div><span>Break Ended</span><strong>@ViewBag.BreakEndTime</strong></div>
                </div>
                <div class="fh-stat">
                    <div class="fh-stat-icon total"><i class="fa-regular fa-clock"></i></div>
                    <div><span>Total Break</span><strong>@ViewBag.TotalBreakTime</strong></div>
                </div>
                <div class="fh-stat">
                    <div class="fh-stat-icon worked"><i class="fa-solid fa-stopwatch"></i></div>
                    <div><span>Worked Time</span><strong>@ViewBag.WorkedTime</strong></div>
                </div>
                <div class="fh-stat">
                    <div class="fh-stat-icon out"><i class="fa-solid fa-right-from-bracket"></i></div>
                    <div><span>Punch Out</span><strong>@ViewBag.PunchOutTime</strong></div>
                </div>
            </div>
        </div>
    </section>

    <!-- PROFILE -->
    <section id="profile" class="fh-profile-section">
        <div class="fh-section-label">EMPLOYEE INFORMATION</div>
        <div class="fh-section-title-row">
            <h3>My Profile</h3>
            <span class="fh-profile-tag"><i class="fa-solid fa-user-check"></i> Personal Profile</span>
        </div>

        <div class="fh-profile-grid">

            <div class="fh-info-card">
                <div class="fh-info-title"><i class="fa-solid fa-briefcase"></i> Work Information</div>
                <div class="fh-details">
                    <div><span>Employee Code</span><strong id="pEmployeeCode">--</strong></div>
                    <div><span>Department</span><strong id="pDepartment">--</strong></div>
                    <div><span>Designation</span><strong id="pDesignation">--</strong></div>
                    <div><span>Role</span><strong id="pRole">--</strong></div>
                    <div><span>Reporting Manager</span><strong id="pManager">--</strong></div>
                    <div><span>Reporting Team Leader</span><strong id="pTeamLeader">--</strong></div>
                    <div><span>Date Joined</span><strong id="pDateJoined">--</strong></div>
                    <div><span>Shift</span><strong id="pShift">--</strong></div>
                </div>
            </div>

            <div class="fh-info-card">
                <div class="fh-info-title"><i class="fa-solid fa-user"></i> Personal Information</div>
                <div class="fh-details">
                    <div><span>Gender</span><strong id="pGender">--</strong></div>
                    <div><span>Marital Status</span><strong id="pMaritalStatus">--</strong></div>
                    <div><span>Date of Birth</span><strong id="pDob">--</strong></div>
                    <div><span>Blood Group</span><strong id="pBloodGroup">--</strong></div>
                    <div><span>PAN</span><strong id="pPan">--</strong></div>
                    <div><span>Aadhaar</span><strong id="pAadhaar">--</strong></div>
                    <div class="fh-detail-wide"><span>Father Name</span><strong id="pFatherName">--</strong></div>
                </div>
            </div>

            <div class="fh-info-card">
                <div class="fh-info-title"><i class="fa-solid fa-phone"></i> Contact Information</div>
                <div class="fh-details">
                    <div class="fh-detail-wide"><span>Official Email</span><strong id="pEmail">--</strong></div>
                    <div><span>Personal Email</span><strong id="pPersonalEmail">--</strong></div>
                    <div><span>Mobile</span><strong id="pMobile">--</strong></div>
                    <div><span>Emergency Contact</span><strong id="pEmergency">--</strong></div>
                    <div><span>Emergency Number</span><strong id="pEmergencyNumber">--</strong></div>
                </div>
            </div>

            <div class="fh-info-card">
                <div class="fh-info-title"><i class="fa-solid fa-location-dot"></i> Address</div>
                <div class="fh-address">
                    <span>Permanent Address</span>
                    <div id="pPermanentAddress">--</div>
                    <span>Residential Address</span>
                    <div id="pResidentialAddress">--</div>
                </div>
            </div>
        </div>
    </section>

    <!-- DOCUMENTS -->
    <section id="documents" class="fh-documents-section">
        <div class="fh-section-title-row">
            <div>
                <div class="fh-section-label">DOCUMENT CENTRE</div>
                <h3>My Documents</h3>
            </div>
            <span class="fh-document-note">PDF, JPG, JPEG or PNG · Maximum 10 MB each</span>
        </div>

        <div class="fh-document-grid">
            <div class="fh-document-card">
                <div class="fh-document-icon aadhaar"><i class="fa-solid fa-fingerprint"></i></div>
                <div class="fh-document-copy">
                    <strong>Aadhaar Card</strong>
                    <span id="myAadhaarStatus">Checking...</span>
                    <div id="myAadhaarActions" class="fh-document-actions"></div>
                </div>
                <form asp-controller="EmployeeDocuments" asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="documentType" value="aadhaar" />
                    <input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required />
                    <button type="submit" class="fh-upload-button"><i class="fa-solid fa-cloud-arrow-up"></i> Upload / Replace</button>
                </form>
            </div>

            <div class="fh-document-card">
                <div class="fh-document-icon pan"><i class="fa-solid fa-address-card"></i></div>
                <div class="fh-document-copy">
                    <strong>PAN Card</strong>
                    <span id="myPanStatus">Checking...</span>
                    <div id="myPanActions" class="fh-document-actions"></div>
                </div>
                <form asp-controller="EmployeeDocuments" asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="documentType" value="pan" />
                    <input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required />
                    <button type="submit" class="fh-upload-button"><i class="fa-solid fa-cloud-arrow-up"></i> Upload / Replace</button>
                </form>
            </div>
        </div>
    </section>
</div>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">

<style>
    .fh-dashboard-reference {
        --fh-blue:#075fc9;
        --fh-navy:#123a78;
        --fh-cyan:#0e8bd1;
        --fh-green:#0b9f68;
        --fh-gold:#f0b51b;
        --fh-red:#ef4444;
        --fh-text:#173b69;
        --fh-muted:#7184a0;
        --fh-border:#dbe7f5;
        --fh-bg:#f5f9ff;
        color:var(--fh-text);
        font-family:"Segoe UI",Arial,sans-serif;
        padding:10px 14px 24px;
        background:linear-gradient(180deg,#f9fbff 0%,#f2f7fd 100%);
        min-height:calc(100vh - 95px);
    }

    .fh-dashboard-reference * { box-sizing:border-box; }

    .fh-hero {
        min-height:170px;
        border-radius:15px;
        overflow:hidden;
        position:relative;
        display:flex;
        align-items:stretch;
        justify-content:space-between;
        background:linear-gradient(110deg,#eaf6ff 0%,#ffffff 53%,#effaf8 100%);
        border:1px solid #d7e7f7;
        box-shadow:0 9px 25px rgba(20,67,120,.09);
    }
    .fh-hero-main { display:flex; align-items:center; gap:20px; padding:22px 26px; min-width:50%; z-index:2; }
    .fh-avatar-xl {
        width:104px;height:104px;border-radius:50%;flex:0 0 104px;
        display:flex;align-items:center;justify-content:center;
        background:linear-gradient(135deg,#0d64cb,#0b8e78);
        border:5px solid #fff; box-shadow:0 4px 16px rgba(11,79,151,.22);
        color:#fff;font-size:27px;font-weight:800;
    }
    .fh-greeting { font-size:11px;font-weight:800;letter-spacing:1.1px;color:#5e7899; }
    .fh-hero-copy h2 { margin:3px 0 2px;font-size:32px;line-height:1.05;color:#143d80;font-weight:800; }
    .fh-identity { font-size:14px;font-weight:650;color:#234c82; }
    .fh-hero-pills { display:flex;flex-wrap:wrap;gap:7px;margin-top:15px; }
    .fh-hero-pills span {
        background:#fff;border:1px solid #d6e5f5;border-radius:18px;padding:7px 10px;
        font-size:10px;font-weight:700;color:#315783;box-shadow:0 2px 6px rgba(15,58,105,.05);
    }
    .fh-hero-pills i { color:var(--fh-blue);margin-right:4px; }

    .fh-hero-visual {
        width:52%;min-width:390px;position:relative;overflow:hidden;
        clip-path:polygon(7% 0,100% 0,100% 100%,0 100%);
    }
    .fh-hero-photo {
        position:absolute;inset:0;
        background-image:linear-gradient(90deg,rgba(255,255,255,.12),rgba(8,58,120,.02)),
                          url('/images/medical-billing-hero.jpg');
        background-size:cover;background-position:center;
    }
    .fh-hero-overlay {
        position:absolute;left:0;right:0;bottom:0;padding:22px 25px 14px;
        background:linear-gradient(transparent,rgba(8,49,98,.87));color:#fff;
    }
    .fh-hero-overlay strong { display:block;font-size:16px; }
    .fh-hero-overlay small { font-size:9px;opacity:.93; }

    .fh-main-row { display:grid;grid-template-columns:minmax(360px,.95fr) minmax(520px,1.65fr);gap:12px;margin-top:12px; }
    .fh-time-card,.fh-summary-card,.fh-info-card,.fh-document-card {
        background:#fff;border:1px solid var(--fh-border);box-shadow:0 7px 20px rgba(20,67,120,.07);
        border-radius:13px;
    }
    .fh-time-card { padding:19px 21px 15px; }
    .fh-card-title { font-size:15px;font-weight:800;color:#123f7d;display:flex;align-items:center;gap:8px; }
    .fh-card-title i { color:var(--fh-blue);font-size:18px; }
    .fh-big-time { font-size:38px;line-height:1.08;font-weight:850;color:#075fd0;margin-top:12px;font-variant-numeric:tabular-nums; }
    .fh-date { color:#486b94;font-size:13px;margin-top:2px; }
    .fh-time-caption { color:#8a9ab0;font-size:9px;margin-top:2px; }
    .fh-attendance-actions { display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:17px; }
    .fh-punch {
        border:0;border-radius:7px;color:#fff;padding:10px 5px;font-size:11px;font-weight:800;
        display:flex;align-items:center;justify-content:center;gap:5px;min-width:0;
    }
    .fh-punch:disabled { opacity:.48;cursor:not-allowed; }
    .fh-punch:not(:disabled):hover { filter:brightness(1.04);transform:translateY(-1px); }
    .punch-in{background:#10a36e}.break{background:#f2b51c;color:#fff}.resume{background:#2778df}.punch-out{background:#ef4444}

    .fh-summary-card { padding:18px; }
    .fh-summary-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:11px; }
    .fh-status { background:#eaf8f1;color:#07935e;border-radius:15px;padding:6px 9px;font-size:9px;font-weight:800; }
    .fh-summary-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:8px; }
    .fh-stat { border:1px solid #e4edf7;border-radius:10px;padding:9px;display:flex;gap:8px;align-items:center;min-width:0;background:#fcfdff; }
    .fh-stat-icon { width:34px;height:34px;flex:0 0 34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px; }
    .fh-stat-icon.shift{background:#eaf3ff;color:#2874cf}.fh-stat-icon.in{background:#eaf9f0;color:#08a069}
    .fh-stat-icon.break{background:#fff5dd;color:#d69200}.fh-stat-icon.resume{background:#edf2ff;color:#426ee0}
    .fh-stat-icon.total{background:#f1edff;color:#7353d6}.fh-stat-icon.worked{background:#e9fbfb;color:#0c9c9c}
    .fh-stat-icon.out{background:#fff0f0;color:#e34242}
    .fh-stat span { display:block;font-size:9px;color:#8092aa;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
    .fh-stat strong { display:block;font-size:11px;color:#173b69;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
    .fh-stat small { display:block;color:#93a2b5;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }

    .fh-profile-section,.fh-documents-section { margin-top:18px; }
    .fh-section-label { font-size:9px;font-weight:900;letter-spacing:1.3px;color:#7890ae; }
    .fh-section-title-row { display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin:2px 0 9px; }
    .fh-section-title-row h3 { margin:0;font-size:19px;color:#173f79;font-weight:850; }
    .fh-profile-tag { color:#1964bd;background:#eaf3ff;border-radius:15px;padding:6px 9px;font-size:9px;font-weight:800; }
    .fh-profile-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:9px; }
    .fh-info-card { padding:14px;min-height:164px; }
    .fh-info-title { color:#16447f;font-size:12px;font-weight:850;border-bottom:1px solid #edf2f8;padding-bottom:9px;margin-bottom:10px; }
    .fh-info-title i { color:#1470d1;margin-right:6px; }
    .fh-details { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 13px; }
    .fh-details span,.fh-address span { display:block;color:#8394aa;font-size:8px;margin-bottom:2px; }
    .fh-details strong { display:block;color:#274b76;font-size:10px;line-height:1.25;word-break:break-word; }
    .fh-detail-wide { grid-column:1/-1; }
    .fh-address { font-size:10px;color:#274b76;line-height:1.4; }
    .fh-address > div { margin:0 0 10px;white-space:pre-line; }

    .fh-documents-section { padding-bottom:15px; }
    .fh-document-note { color:#8091a8;font-size:9px; }
    .fh-document-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:10px; }
    .fh-document-card { padding:13px;display:grid;grid-template-columns:45px 1fr auto;gap:11px;align-items:center; }
    .fh-document-icon { width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:19px; }
    .fh-document-icon.aadhaar{background:#fff3dc;color:#c78600}.fh-document-icon.pan{background:#edf2ff;color:#416dd5}
    .fh-document-copy strong{display:block;color:#214675;font-size:12px}.fh-document-copy span{display:block;color:#8092a9;font-size:9px;margin-top:2px}
    .fh-document-actions{display:flex;gap:5px;margin-top:5px}.fh-document-actions .btn{font-size:9px!important;padding:3px 7px!important}
    .fh-document-card form { display:flex;flex-direction:column;gap:5px;min-width:170px; }
    .fh-document-card input[type=file] { font-size:8px;width:170px; }
    .fh-upload-button { border:0;background:#edf5ff;color:#1764bb;border-radius:6px;padding:6px 8px;font-size:9px;font-weight:800; }
    .fh-upload-button:hover{background:#dfedff}

    @@media (max-width:1200px){
        .fh-main-row{grid-template-columns:1fr}.fh-profile-grid{grid-template-columns:repeat(2,1fr)}
    }
    @@media (max-width:800px){
        .fh-hero{display:block}.fh-hero-main{padding:18px}.fh-hero-visual{width:100%;min-width:0;height:130px;clip-path:none}
        .fh-summary-grid{grid-template-columns:repeat(2,1fr)}.fh-profile-grid{grid-template-columns:1fr}
        .fh-document-grid{grid-template-columns:1fr}.fh-document-card{grid-template-columns:45px 1fr}
        .fh-document-card form{grid-column:1/-1}.fh-document-card input[type=file]{width:100%}
    }
    @@media (max-width:560px){
        .fh-dashboard-reference{padding:5px}.fh-hero-main{display:block}.fh-avatar-xl{margin-bottom:10px}
        .fh-hero-copy h2{font-size:25px}.fh-attendance-actions{grid-template-columns:repeat(2,1fr)}
        .fh-summary-grid{grid-template-columns:1fr}.fh-details{grid-template-columns:1fr}.fh-detail-wide{grid-column:auto}
    }
</style>


<script>
        document.addEventListener("DOMContentLoaded", function() {

            const btnPunchIn = document.getElementById("btnPunchIn");
            const btnBreak = document.getElementById("btnBreak");
            const btnResume = document.getElementById("btnResume");
            const btnPunchOut = document.getElementById("btnPunchOut");

            const serverISTMilliseconds =
                @Html.Raw(ViewBag.ServerISTMilliseconds ?? 0);

            const clockStartPerformance = performance.now();

            function updateISTClock() {
                const elapsedMilliseconds =
                    performance.now() - clockStartPerformance;

                const now = new Date(
                    serverISTMilliseconds + elapsedMilliseconds
                );

                const istTime = now.toLocaleTimeString("en-IN", {
                    timeZone: "Asia/Kolkata",
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit",
                    hour12: true
                });

                const istDate = now.toLocaleDateString("en-IN", {
                    timeZone: "Asia/Kolkata",
                    weekday: "long",
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                });

                document.getElementById("istClock").innerText = istTime;
                document.getElementById("istDate").innerText = istDate;
            }

            updateISTClock();
            setInterval(updateISTClock, 1000);


            //==================================================
            // Load personal profile and document status
            //==================================================
            function setText(id, value) {
                const el = document.getElementById(id);
                if (el) el.textContent = value || "--";
            }

            function initials(name) {
                if (!name) return "--";
                const parts = name.trim().split(/\s+/).filter(Boolean);
                if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
                return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
            }

            function documentButtons(type, uploaded) {
                const actions = document.getElementById(type === "aadhaar" ? "myAadhaarActions" : "myPanActions");
                const status = document.getElementById(type === "aadhaar" ? "myAadhaarStatus" : "myPanStatus");
                if (!actions || !status) return;

                actions.innerHTML = "";
                status.textContent = uploaded ? "✓ Document uploaded" : "Not uploaded yet";

                if (uploaded) {
                    const view = document.createElement("a");
                    view.className = "btn btn-sm btn-outline-primary";
                    view.href = '@Url.Action("ViewMyDocument", "EmployeeDocuments")' + '?documentType=' + encodeURIComponent(type);
                    view.target = "_blank";
                    view.innerHTML = '<i class="fa-solid fa-eye me-1"></i> View';

                    const download = document.createElement("a");
                    download.className = "btn btn-sm btn-outline-secondary";
                    download.href = '@Url.Action("DownloadMyDocument", "EmployeeDocuments")' + '?documentType=' + encodeURIComponent(type);
                    download.innerHTML = '<i class="fa-solid fa-download me-1"></i> Download';

                    actions.appendChild(view);
                    actions.appendChild(download);
                }
            }


            function maskSensitiveNumber(value) {
                if (!value) return "--";
                const normalized = String(value).replace(/\s+/g, "");
                if (normalized.length <= 4) return normalized;
                return "X".repeat(normalized.length - 4) + normalized.slice(-4);
            }

            fetch('@Url.Action("DashboardData", "EmployeeDocuments")', { credentials: "same-origin" })
                .then(response => {
                    if (!response.ok) throw new Error("Profile could not be loaded.");
                    return response.json();
                })
                .then(data => {
                    setText("profileName", data.employeeName);
                    setText("profileIdentity", `${data.employeeCode || ""} · ${data.designation || "Employee"}`);
                    setText("profileInitials", initials(data.employeeName));
                    setText("pEmployeeCode", data.employeeCode);
                    setText("pCodeHero", data.employeeCode);
                    setText("pDepartment", data.department);
                    setText("pDepartmentHero", data.department);
                    setText("pDesignation", data.designation);
                    setText("pRole", data.role);
                    setText("pShift", data.shift);
                    setText("pShiftHero", data.shift);
                    setText("pDateJoined", data.dateJoined);
                    setText("pManager", data.reportingManager);
                    setText("pTeamLeader", data.reportingTeamLeader);
                    setText("pEmail", data.email);
                    setText("pPersonalEmail", data.personalEmail);
                    setText("pMobile", data.mobile);
                    setText("pEmergency", data.emergencyContactPerson);
                    setText("pEmergencyNumber", data.emergencyContactNumber);
                    setText("pGender", data.gender);
                    setText("pMaritalStatus", data.maritalStatus);
                    setText("pDob", data.dateOfBirth);
                    setText("pBloodGroup", data.bloodGroup);
                    setText("pPan", maskSensitiveNumber(data.panNumber));
                    setText("pAadhaar", maskSensitiveNumber(data.aadharNumber));
                    setText("pFatherName", data.fatherName);
                    setText("pPermanentAddress", data.permanentAddress);
                    setText("pResidentialAddress", data.residentialAddress);
                    documentButtons("aadhaar", data.aadhaarUploaded);
                    documentButtons("pan", data.panUploaded);
                })
                .catch(() => {
                    setText("profileName", "Profile unavailable");
                    setText("profileIdentity", "Please refresh the page.");
                    documentButtons("aadhaar", false);
                    documentButtons("pan", false);
                });

            function doAction(url, color) {
                fetch(url, { method: "POST" })
                    .then(response => response.json())
                    .then(result => {
                        Swal.fire({
                            icon: result.success ? "success" : "error",
                            title: result.title,
                            html: result.message.replace(/\n/g, "<br>"),
                            confirmButtonColor: color
                        }).then(() => {
                            if (result.success) {
                                location.reload();
                            }
                        });
                    });
            }

            if (btnPunchIn)
                btnPunchIn.addEventListener("click",
                    () => doAction('@Url.Action("PunchIn", "Attendance")', "#16a34a"));

            if (btnBreak)
                btnBreak.addEventListener("click",
                    () => doAction('@Url.Action("Break", "Attendance")', "#d97706"));

            if (btnResume)
                btnResume.addEventListener("click",
                    () => doAction('@Url.Action("Resume", "Attendance")', "#0891b2"));

            if (btnPunchOut)
                btnPunchOut.addEventListener("click",
                    () => doAction('@Url.Action("PunchOut", "Attendance")', "#dc2626"));

        });
    </script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const mainClock = document.getElementById("istClockMain");
        const sourceClock = document.getElementById("istClock");
        if (mainClock && sourceClock) {
            const syncClock = () => { mainClock.textContent = sourceClock.textContent; };
            syncClock();
            setInterval(syncClock, 250);
        }
    });
</script>
