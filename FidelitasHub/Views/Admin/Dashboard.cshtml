@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">

    <h2 class="text-primary fw-bold">
        🏢 Fidelitas Hub - Admin Portal
    </h2>

    <hr />

    <h4>
        Welcome,
        <span class="text-success">
            @ViewBag.EmployeeName
        </span>
    </h4>

    <br />

    <div class="row">

        <div class="col-md-3">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h5>Total Employees</h5>

                    <h2>0</h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h5>Present</h5>

                    <h2>0</h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h5>On Break</h5>

                    <h2>0</h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h5>On Leave</h5>

                    <h2>0</h2>

                </div>

            </div>

        </div>

    </div>

    <br />

    <!-- ================= QUICK ACTIONS ================= -->

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            Quick Actions

        </div>

        <div class="card-body">

            <a asp-controller="Employee"
               asp-action="Index"
               class="btn btn-primary me-2 mb-2">

                👨‍💼 Employees

            </a>

            <a asp-controller="Department"
               asp-action="Index"
               class="btn btn-success me-2 mb-2">

                🏢 Departments

            </a>

            <a href="#"
               class="btn btn-warning me-2 mb-2">

                💼 Designations

            </a>

            <a asp-controller="Shift"
               asp-action="Index"
               class="btn btn-secondary me-2 mb-2">

                🕒 Shifts

            </a>

            <a href="#"
               class="btn btn-info me-2 mb-2">

                📊 Reports

            </a>

        </div>

    </div>

</div>