@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">

    <!-- Header -->

    <div class="row mb-4">

        <div class="col-md-8">

            <h2 class="fw-bold text-primary">
                Admin Dashboard
            </h2>

            <p class="text-muted mb-0">
                Welcome,
                <strong>@ViewBag.EmployeeName</strong>
            </p>

        </div>

        <div class="col-md-4 text-end">

            <h5 id="clock" class="text-secondary"></h5>

        </div>

    </div>

    <!-- KPI Cards -->

    <div class="row g-3">

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <h6 class="text-muted">Total Employees</h6>

                    <h1 class="text-primary">168</h1>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <h6 class="text-muted">Present Today</h6>

                    <h1 class="text-success">0</h1>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <h6 class="text-muted">On Leave</h6>

                    <h1 class="text-warning">0</h1>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <h6 class="text-muted">Late Arrivals</h6>

                    <h1 class="text-danger">0</h1>

                </div>

            </div>

        </div>

    </div>

    <br />

    <div class="row">

        <!-- Quick Actions -->

        <div class="col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">

                    Quick Actions

                </div>

                <div class="card-body">

                    <div class="d-grid gap-2">

                        <a asp-controller="Employee"
                           asp-action="Index"
                           class="btn btn-outline-primary">

                            👨 Employee Master

                        </a>

                        <a asp-controller="Department"
                           asp-action="Index"
                           class="btn btn-outline-success">

                            🏢 Department Master

                        </a>

                        <a asp-controller="Shift"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            🕒 Shift Master

                        </a>

                        <a asp-controller="LeaveBalance"
                           asp-action="Import"
                           class="btn btn-outline-warning">

                            💰 Leave Balance Import

                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- System Status -->

        <div class="col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header bg-success text-white">

                    System Status

                </div>

                <div class="card-body">

                    <table class="table table-borderless">

                        <tr>

                            <td>Attendance Module</td>

                            <td><span class="badge bg-success">Active</span></td>

                        </tr>

                        <tr>

                            <td>Leave Module</td>

                            <td><span class="badge bg-warning text-dark">In Progress</span></td>

                        </tr>

                        <tr>

                            <td>Employee Master</td>

                            <td><span class="badge bg-success">Completed</span></td>

                        </tr>

                        <tr>

                            <td>Shift Master</td>

                            <td><span class="badge bg-success">Completed</span></td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<script>

    function updateClock() {

        const now = new Date();

        const options = {

            weekday: "long",
            year: "numeric",
            month: "long",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: true,
            timeZone: "Asia/Kolkata"

        };

        document.getElementById("clock").innerHTML =
            now.toLocaleString("en-IN", options) + " IST";

    }

    updateClock();

    setInterval(updateClock,1000);

</script>