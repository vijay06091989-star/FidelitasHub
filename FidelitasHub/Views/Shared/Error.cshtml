@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="fh-card mt-4">
            <div class="card-body text-center p-5">

                <div class="stat__icon mx-auto mb-3 stat--danger"
                     style="width:64px;height:64px;font-size:1.6rem;background:rgba(220,38,38,.12);color:var(--fh-danger);">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <h1 class="h4 mb-2">Something went wrong</h1>
                <p class="text-muted mb-4">An error occurred while processing your request.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4">
                        Request ID: <code>@Model.RequestId</code>
                    </p>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="fa-solid fa-house me-1"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</div>
