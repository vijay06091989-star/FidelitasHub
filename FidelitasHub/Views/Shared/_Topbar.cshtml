@{
    var employeeName = Context.Session.GetString("EmployeeName");
    var topRole = Context.Session.GetString("Role");
    var displayName = string.IsNullOrEmpty(employeeName) ? "Guest" : employeeName;

    var initials = "U";
    if (!string.IsNullOrWhiteSpace(employeeName))
    {
        var parts = employeeName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : employeeName.Trim()[..1].ToUpper();
    }
}

<header class="topbar">

    <button class="topbar__toggle" type="button" onclick="fhToggleSidebar()" aria-label="Toggle menu">
        <i class="fa-solid fa-bars"></i>
    </button>

    <span class="topbar__title">@(ViewData["Title"] ?? "Dashboard")</span>

    <div class="topbar__spacer"></div>

    <span class="topbar__clock d-none d-md-inline" data-clock></span>

    <button class="topbar__icon-btn" type="button" onclick="fhToggleTheme()" aria-label="Toggle theme" title="Toggle light / dark">
        <i class="fa-solid fa-moon" data-theme-icon></i>
    </button>

    <div class="topbar__user">
        <div class="topbar__avatar">@initials</div>
        <div class="d-none d-sm-block">
            <div class="topbar__user-name">@displayName</div>
            <div class="topbar__user-role">@(string.IsNullOrEmpty(topRole) ? "" : topRole)</div>
        </div>
    </div>

    <a asp-controller="Account" asp-action="Logout" class="topbar__icon-btn" title="Logout" aria-label="Logout">
        <i class="fa-solid fa-right-from-bracket"></i>
    </a>

</header>
