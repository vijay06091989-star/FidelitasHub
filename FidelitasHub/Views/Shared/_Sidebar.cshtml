@using FidelitasHub.Data
@inject ApplicationDbContext Db

@{
    var role = (Context.Session.GetString("Role") ?? "").Trim();

    bool isAdmin = role.Equals("Admin", StringComparison.OrdinalIgnoreCase)
                || role.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase);

    bool isManager = role.Equals("Manager", StringComparison.OrdinalIgnoreCase);

    bool isTeamLeader = role.Equals("Team Leader", StringComparison.OrdinalIgnoreCase);

    bool isHR = role.Equals("HR", StringComparison.OrdinalIgnoreCase);

    bool isEmployee =
        role.Equals("Employee", StringComparison.OrdinalIgnoreCase) ||
        role.Equals("Employees", StringComparison.OrdinalIgnoreCase);
}

<aside class="sidebar">

    <div class="sidebar__brand">
        <span class="sidebar__brand-mark">
            <i class="fa-solid fa-building-shield"></i>
        </span>
        <span>Fidelitas&nbsp;Hub</span>
    </div>

    <nav class="sidebar__nav">

        <!-- ================= OVERVIEW ================= -->

        <div class="sidebar__section">Overview</div>

        <a class="sidebar__link" asp-controller="Attendance" asp-action="Dashboard">
            <i class="fa-solid fa-gauge-high"></i>
            <span>My Dashboard</span>
        </a>

        @if (isAdmin)
        {
            <a class="sidebar__link" asp-controller="Admin" asp-action="Dashboard">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Admin Dashboard</span>
            </a>
        }

        <!-- ================= ATTENDANCE ================= -->

        <div class="sidebar__section">Attendance</div>

        <!-- Today's Attendance -->
        @if (!isEmployee)
        {
            <a class="sidebar__link"
               asp-controller="Attendance"
               asp-action="TodayAttendance">

                <i class="fa-solid fa-calendar-day"></i>

                <span>Today's Attendance</span>

            </a>
        }


        <!-- Attendance Register -->
        @if (isAdmin || isManager || isTeamLeader || isEmployee)
        {
            <a class="sidebar__link"
               asp-controller="Attendance"
               asp-action="Register">

                <i class="fa-solid fa-clipboard-list"></i>

                <span>Attendance Register</span>

            </a>
        }


        <!-- Attendance Correction -->
        @if (isAdmin)
        {
            <a class="sidebar__link"
               asp-controller="Attendance"
               asp-action="AttendanceCorrection">

                <i class="fa-solid fa-pen-to-square"></i>

                <span>Attendance Correction</span>

            </a>
        }

        <!-- ================= LEAVE ================= -->

        <div class="sidebar__section">Leave</div>

        <a class="sidebar__link" asp-controller="Leave" asp-action="ApplyLeave">
            <i class="fa-solid fa-plane-departure"></i>
            <span>Apply Leave</span>
        </a>

        <a class="sidebar__link" asp-controller="Leave" asp-action="MyLeaveHistory">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span>My Leave History</span>
        </a>

        @if (isAdmin || isTeamLeader)
        {
            <a class="sidebar__link" asp-controller="LeaveApproval" asp-action="Index">
                <i class="fa-solid fa-circle-check"></i>
                <span>Lead Approval</span>
            </a>
        }

        @if (isAdmin || isManager)
        {
            <a class="sidebar__link" asp-controller="ManagerApproval" asp-action="Index">
                <i class="fa-solid fa-user-check"></i>
                <span>Manager Approval</span>
            </a>
        }

        @if (isAdmin || isManager || isTeamLeader)
        {
            <a class="sidebar__link" asp-controller="Leave" asp-action="LeaveRegister">
                <i class="fa-solid fa-list-check"></i>
                <span>Leave Register</span>
            </a>

            <a class="sidebar__link" asp-controller="Leave" asp-action="PermissionRegister">
                <i class="fa-solid fa-clock"></i>
                <span>Permission Register</span>
            </a>
        }

        @if (isAdmin)
        {
            <a class="sidebar__link" asp-controller="LeaveBalance" asp-action="Import">
                <i class="fa-solid fa-file-import"></i>
                <span>Balance Import</span>
            </a>

            <a class="sidebar__link" asp-controller="Holiday" asp-action="Index">
                <i class="fa-solid fa-umbrella-beach"></i>
                <span>Holiday Calendar</span>
            </a>

            <a class="sidebar__link" asp-controller="Payroll" asp-action="Index">
                <i class="fa-solid fa-calendar-days"></i>
                <span>Payroll Calendar</span>
            </a>
        }

        <!-- ================= PRODUCTIVITY ================= -->
        
        <div class="sidebar__section">Productivity</div>

            <a class="sidebar__link"
               asp-controller="Productivity"
               asp-action="Index">

                <i class="fa-solid fa-chart-line"></i>
                <span>Productivity Dashboard</span>

            </a>

            <div class="sidebar__group">

                <a class="sidebar__link" href="#"
                   onclick="toggleProductivityClients(event)">

                    <i class="fa-solid fa-handshake"></i>

                    <span>Clients</span>

                    <i id="productivityClientCaret"
                       class="fa-solid fa-chevron-right caret"></i>

                </a>

                <div id="productivityClientMenu"
                     class="sidebar__submenu"
                     style="display:none;">

                    @{
                        var productivityClients = Db.Clients
                            .Where(c => c.IsActive)
                            .OrderBy(c => c.ClientCode)
                            .ToList();
                    }

                    <div class="productivity-client-selector">

                        <div class="productivity-client-input-wrap">

                            <input type="text"
                                   id="productivityClientSearch"
                                   class="productivity-client-input"
                                   placeholder="Select client..."
                                   autocomplete="off"
                                   oninput="filterProductivityClients()" />

                            <button type="button"
                                    class="productivity-client-arrow"
                                    onclick="toggleProductivityClientDropdown(event)"
                                    tabindex="-1">

                                <i id="productivityClientArrow"
                                   class="fa-solid fa-chevron-down"></i>

                            </button>

                        </div>

                        <div id="productivityClientDropdown"
                             class="productivity-client-dropdown">

                            @foreach (var client in productivityClients)
                            {
                                <button type="button"
                                        class="productivity-client-option"
                                        data-code="@client.ClientCode"
                                        data-id="@client.ClientId"
                                        onclick="selectProductivityClient(this)">

                                    @client.ClientCode

                                </button>
                            }

                        </div>

                    </div>

                </div>

            </div>

            <a class="sidebar__link"
               asp-controller="Productivity"
               asp-action="Setup">

                <i class="fa-solid fa-sliders"></i>
                <span>Productivity Setup</span>

            </a>

            <a class="sidebar__link"
               asp-controller="Productivity"
               asp-action="Register">

                <i class="fa-solid fa-clipboard-list"></i>
                <span>Productivity Register</span>

            </a>

            <a class="sidebar__link"
               asp-controller="Productivity"
               asp-action="Reports">

                <i class="fa-solid fa-chart-column"></i>
                <span>Productivity Reports</span>

            </a>

        <!-- ================= ADMINISTRATION ================= -->
        @if (isAdmin)
        {
            <div class="sidebar__section">Administration</div>

            <!-- ================= MASTERS ================= -->

            <div class="sidebar__group">

                <a class="sidebar__link" href="#">
                    <i class="fa-solid fa-database"></i>
                    <span>Masters</span>
                    <i class="fa-solid fa-chevron-right caret"></i>
                </a>

                <div class="sidebar__submenu">

                    <a class="sidebar__link" asp-controller="Employee" asp-action="Index">
                        <span>Employees</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Department" asp-action="Index">
                        <span>Departments</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Designation" asp-action="Index">
                        <span>Designations</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Shift" asp-action="Index">
                        <span>Shifts</span>
                    </a>

                    <a class="sidebar__link" asp-controller="LeaveType" asp-action="Index">
                        <span>Leave Types</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Holiday" asp-action="Index">
                        <span>Holidays</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Client" asp-action="Index">
                        <span>Clients</span>
                    </a>

                </div>

            </div>

            <!-- ================= REPORTS ================= -->

            <div class="sidebar__group">

                <a class="sidebar__link" href="#">
                    <i class="fa-solid fa-chart-column"></i>
                    <span>Reports</span>
                    <i class="fa-solid fa-chevron-right caret"></i>
                </a>

                <div class="sidebar__submenu">

                    <a class="sidebar__link" asp-controller="Reports" asp-action="Attendance">
                        <span>Attendance Report</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Reports" asp-action="Employee">
                        <span>Employee Report</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Reports" asp-action="Leave">
                        <span>Leave Report</span>
                    </a>

                </div>

            </div>

            <!-- ================= SYSTEM ================= -->

            <div class="sidebar__group">

                <a class="sidebar__link" href="#">
                    <i class="fa-solid fa-gear"></i>
                    <span>System</span>
                    <i class="fa-solid fa-chevron-right caret"></i>
                </a>

                <div class="sidebar__submenu">

                    <a class="sidebar__link" asp-controller="Administration" asp-action="Users">
                        <span>Users</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Administration" asp-action="Roles">
                        <span>Roles</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Administration" asp-action="CompanySettings">
                        <span>Company Settings</span>
                    </a>

                    <a class="sidebar__link" asp-controller="Administration" asp-action="AuditLogs">
                        <span>Audit Logs</span>
                    </a>

                </div>

            </div>

            <!-- ================= EMAIL ================= -->

            <div class="sidebar__group">

                <a class="sidebar__link" href="#">
                    <i class="fa-solid fa-envelope"></i>
                    <span>Email</span>
                    <i class="fa-solid fa-chevron-right caret"></i>
                </a>

                <div class="sidebar__submenu">

                    <a class="sidebar__link" asp-controller="EmailSettings" asp-action="Index">
                        <span>SMTP Settings</span>
                    </a>

                    <a class="sidebar__link" asp-controller="EmailTemplate" asp-action="Index">
                        <span>Templates</span>
                    </a>

                    <a class="sidebar__link" asp-controller="EmployeeEmail" asp-action="Index">
                        <span>Send Email</span>
                    </a>

                    <a class="sidebar__link" asp-controller="BulkEmail" asp-action="Index">
                        <span>Bulk Email</span>
                    </a>

                </div>

            </div>

        }

    </nav>

</aside>

<div class="sidebar__backdrop"></div>

        <script>

            // ==========================================================
            // PRODUCTIVITY CLIENT MENU
            // ==========================================================

            function toggleProductivityClients(event) {

                event.preventDefault();

                const menu =
                    document.getElementById("productivityClientMenu");

                const caret =
                    document.getElementById("productivityClientCaret");

                if (!menu) return;

                if (menu.style.display === "none" ||
                    menu.style.display === "") {

                    menu.style.display = "block";

                    if (caret) {
                        caret.classList.remove("fa-chevron-right");
                        caret.classList.add("fa-chevron-down");
                    }

                }
                else {

                    menu.style.display = "none";

                    if (caret) {
                        caret.classList.remove("fa-chevron-down");
                        caret.classList.add("fa-chevron-right");
                    }

                    closeProductivityClientDropdown();
                }
            }


            // ==========================================================
            // OPEN / CLOSE CLIENT DROPDOWN
            // ==========================================================

            function toggleProductivityClientDropdown(event) {

                event.preventDefault();
                event.stopPropagation();

                const dropdown =
                    document.getElementById("productivityClientDropdown");

                const arrow =
                    document.getElementById("productivityClientArrow");

                if (!dropdown) return;

                if (dropdown.classList.contains("show")) {

                    closeProductivityClientDropdown();

                }
                else {

                    dropdown.classList.add("show");

                    if (arrow) {
                        arrow.classList.remove("fa-chevron-down");
                        arrow.classList.add("fa-chevron-up");
                    }
                }
            }


            // ==========================================================
            // FILTER CLIENTS WHILE TYPING
            // ==========================================================

            function filterProductivityClients() {

                const input =
                    document.getElementById("productivityClientSearch");

                const dropdown =
                    document.getElementById("productivityClientDropdown");

                if (!input || !dropdown) return;

                const searchText =
                    input.value.trim().toLowerCase();

                const clients =
                    dropdown.querySelectorAll(".productivity-client-option");

                clients.forEach(function(client) {

                    const code =
                        (client.dataset.code || "").toLowerCase();

                    if (code.includes(searchText)) {

                        client.style.display = "block";

                    }
                    else {

                        client.style.display = "none";

                    }
                });

                dropdown.classList.add("show");

                const arrow =
                    document.getElementById("productivityClientArrow");

                if (arrow) {
                    arrow.classList.remove("fa-chevron-down");
                    arrow.classList.add("fa-chevron-up");
                }
            }


            // ==========================================================
            // SELECT CLIENT
            // ==========================================================

            function selectProductivityClient(element) {

                if (!element) return;

                const clientId =
                    element.dataset.id;

                if (!clientId) return;

                window.location.href =
                    "/Productivity/Client?id=" + clientId;
            }


            // ==========================================================
            // CLOSE DROPDOWN
            // ==========================================================

            function closeProductivityClientDropdown() {

                const dropdown =
                    document.getElementById("productivityClientDropdown");

                const arrow =
                    document.getElementById("productivityClientArrow");

                if (dropdown) {
                    dropdown.classList.remove("show");
                }

                if (arrow) {
                    arrow.classList.remove("fa-chevron-up");
                    arrow.classList.add("fa-chevron-down");
                }
            }


            // ==========================================================
            // CLICK OUTSIDE DROPDOWN
            // ==========================================================

            document.addEventListener("click", function(event) {

                const selector =
                    document.querySelector(".productivity-client-selector");

                if (!selector) return;

                if (!selector.contains(event.target)) {

                    closeProductivityClientDropdown();

                }

            });

        </script>