@{
    var role = Context.Session.GetString("Role");
    bool isAdmin = role == "Admin" || role == "SuperAdmin";
}

<aside class="sidebar">

    <div class="sidebar__brand">
        <span class="sidebar__brand-mark"><i class="fa-solid fa-building-shield"></i></span>
        <span>Fidelitas&nbsp;Hub</span>
    </div>

    <nav class="sidebar__nav">

        <!-- Dashboards -->
        <div class="sidebar__section">Overview</div>

        <a class="sidebar__link" asp-controller="Attendance" asp-action="Dashboard">
            <i class="fa-solid fa-gauge-high"></i><span>My Dashboard</span>
        </a>
        @if (isAdmin)
        {
            <a class="sidebar__link" asp-controller="Admin" asp-action="Dashboard">
                <i class="fa-solid fa-chart-pie"></i><span>Admin Dashboard</span>
            </a>
        }

        <!-- Attendance -->
        <div class="sidebar__section">Attendance</div>

        <a class="sidebar__link" asp-controller="Attendance" asp-action="TodayAttendance">
            <i class="fa-solid fa-calendar-day"></i><span>Today's Attendance</span>
        </a>
        @if (isAdmin)
        {
            <a class="sidebar__link" asp-controller="Attendance" asp-action="Register">
                <i class="fa-solid fa-clipboard-list"></i><span>Attendance Register</span>
            </a>
            <a class="sidebar__link" asp-controller="Attendance" asp-action="AttendanceCorrection">
                <i class="fa-solid fa-pen-to-square"></i><span>Correction</span>
            </a>
        }

        <!-- Leave -->
        <div class="sidebar__section">Leave</div>

        <a class="sidebar__link" asp-controller="Leave" asp-action="ApplyLeave">
            <i class="fa-solid fa-plane-departure"></i><span>Apply Leave</span>
        </a>
        @if (isAdmin)
        {
            <a class="sidebar__link" asp-controller="LeaveApproval" asp-action="Index">
                <i class="fa-solid fa-circle-check"></i><span>Leave Approval</span>
            </a>
            <a class="sidebar__link" asp-controller="LeaveBalance" asp-action="Import">
                <i class="fa-solid fa-file-import"></i><span>Balance Import</span>
            </a>
        }

        @if (isAdmin)
        {
            <!-- Masters -->
            <div class="sidebar__section">Masters</div>

            <a class="sidebar__link" asp-controller="Employee" asp-action="Index">
                <i class="fa-solid fa-users"></i><span>Employees</span>
            </a>
            <a class="sidebar__link" asp-controller="Department" asp-action="Index">
                <i class="fa-solid fa-sitemap"></i><span>Departments</span>
            </a>
            <a class="sidebar__link" asp-controller="Shift" asp-action="Index">
                <i class="fa-solid fa-business-time"></i><span>Shifts</span>
            </a>

            <!-- Reports -->
            <div class="sidebar__section">Reports &amp; Admin</div>

            <div class="sidebar__group">
                <a class="sidebar__link" href="#">
                    <i class="fa-solid fa-chart-column"></i><span>Reports</span>
                    <i class="fa-solid fa-chevron-right caret"></i>
                </a>
                <div class="sidebar__submenu">
                    <a class="sidebar__link" href="#"><span>Attendance Report</span></a>
                    <a class="sidebar__link" href="#"><span>Employee Report</span></a>
                    <a class="sidebar__link" href="#"><span>Leave Report</span></a>
                </div>
            </div>

            <div class="sidebar__group">
                <a class="sidebar__link" href="#">
                    <i class="fa-solid fa-gear"></i><span>Administration</span>
                    <i class="fa-solid fa-chevron-right caret"></i>
                </a>
                <div class="sidebar__submenu">
                    <a class="sidebar__link" href="#"><span>Users</span></a>
                    <a class="sidebar__link" href="#"><span>Roles</span></a>
                    <a class="sidebar__link" href="#"><span>Company Settings</span></a>
                    <a class="sidebar__link" href="#"><span>Audit Logs</span></a>
                </div>
            </div>
        }

    </nav>
</aside>

<div class="sidebar__backdrop"></div>
