<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fidelitas Hub</title>

    <!-- Set theme before paint to avoid a flash of the wrong theme -->
    <script>
        (function () {
            try {
                var t = localStorage.getItem('fh-theme') ||
                        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', t);
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @{
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
        bool isLoginPage = currentAction == "Login";
    }

    @if (isLoginPage)
    {
        @RenderBody()
    }
    else
    {
        <div class="app-shell">

            @await Html.PartialAsync("_Sidebar")

            <div class="app-main">

                @await Html.PartialAsync("_Topbar")

                <main class="app-content">
                    @RenderBody()
                </main>

                <footer class="app-footer">
                    © 2026 Fidelitas Hub · Integrated HR Management
                </footer>

            </div>
        </div>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>

    @await Html.PartialAsync("_FlashScripts")

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
