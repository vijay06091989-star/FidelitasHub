<!DOCTYPE html>
<html lang="en" data-bs-theme="light" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fidelitas Hub</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @{
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

        bool isLoginPage = currentAction == "Login";
        bool isChangePasswordPage = currentAction == "ChangePassword";
        bool hideShell = isLoginPage || isChangePasswordPage;

        var employeeName = Context.Session.GetString("EmployeeName");
        var role = Context.Session.GetString("Role");

        bool isAdmin = role == "Admin" || role == "SuperAdmin";
        bool isManager = role == "Manager";
        bool isTeamLeader = role == "Team Leader";
        bool isHR = role == "HR";
        bool isEmployee = role == "Employee";
        bool isProductivityViewer = string.Equals(role, "Viewer", StringComparison.OrdinalIgnoreCase);
        bool isProductivityEditor = string.Equals(role, "Editor", StringComparison.OrdinalIgnoreCase);
        bool isProductivityOnly = isProductivityViewer || isProductivityEditor;
    }

    @if (hideShell)
{
    @RenderBody()
}
else
{
            <div class="app-shell">

                @await Html.PartialAsync("_Sidebar")

                <div class="app-main">

                    @await Html.PartialAsync("_Topbar")

                    <main class="app-content">
                        @RenderBody()
                    </main>

                    <footer class="app-footer">
                        © 2026 Fidelitas Hub · Integrated HR Management
                    </footer>

                </div>
            </div>

            <div>

                <i class="fa-solid fa-user"></i>

                <strong>

                    @(string.IsNullOrEmpty(employeeName) ? "Guest" : employeeName)

                </strong>

                &nbsp;&nbsp;

                <a asp-controller="Account"
                asp-action="Logout"
                class="btn btn-sm btn-light">

                    Logout

                </a>

            </div>

        
        }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>

    @await Html.PartialAsync("_FlashScripts")

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
