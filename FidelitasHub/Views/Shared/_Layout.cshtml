<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fidelitas Hub</title>

    <!-- Set theme before paint to avoid a flash of the wrong theme -->
    <script>
        (function () {
            try {
                var t = localStorage.getItem('fh-theme') ||
                        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', t);
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @{
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

        bool isLoginPage = currentAction == "Login";

        var employeeName = Context.Session.GetString("EmployeeName");
        var role = Context.Session.GetString("Role");

        bool isAdmin = role == "Admin" || role == "SuperAdmin";
        bool isManager = role == "Manager";
        bool isTeamLeader = role == "Team Leader";
        bool isHR = role == "HR";
        bool isEmployee = role == "Employee";
    }

    @if (isLoginPage)
        {
            @RenderBody()
        }
        else
        {
            <div class="app-shell">

                @await Html.PartialAsync("_Sidebar")

                <div class="app-main">

                    @await Html.PartialAsync("_Topbar")

                    <main class="app-content">
                        @RenderBody()
                    </main>

                    <footer class="app-footer">
                        © 2026 Fidelitas Hub · Integrated HR Management
                    </footer>

                </div>
            </div>

            <div>

                <i class="fa-solid fa-user"></i>

                <strong>

                    @(string.IsNullOrEmpty(employeeName) ? "Guest" : employeeName)

                </strong>

                &nbsp;&nbsp;

                <a asp-controller="Account"
                asp-action="Logout"
                class="btn btn-sm btn-light">

                    Logout

                </a>

            </div>

            <!-- =================== MENU =================== -->
            @if (!isLoginPage)
            {
                <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">

                    <div class="container-fluid">

                        <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainMenu">

                            <span class="navbar-toggler-icon"></span>

                        </button>

                        <div class="collapse navbar-collapse"
                        id="mainMenu">

                            <ul class="navbar-nav">

                                <!-- Dashboard -->

                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                    href="#"
                                    data-bs-toggle="dropdown">

                                        <i class="fa-solid fa-house"></i>

                                        Dashboard

                                    </a>

                                    <ul class="dropdown-menu">

                                        <!-- Employee Dashboard (Everyone) -->
                                    @if (isAdmin || isManager || isTeamLeader || isHR)
                                    {
                                        <li>
                                            <a asp-controller="Attendance"
                                               asp-action="TodayAttendance"
                                               class="dropdown-item">
                                                📅 Today's Attendance
                                            </a>
                                        </li>
                                    }

                                        <!-- Admin Dashboard -->
                                        @if (isAdmin)
                                        {
                                            <li>
                                                <a asp-controller="Admin"
                                                asp-action="Dashboard"
                                                class="dropdown-item">

                                                    📊 Admin Dashboard

                                                </a>
                                            </li>
                                        }

                                    </ul>

                                </li>

                                <!-- Attendance -->

                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                    href="#"
                                    data-bs-toggle="dropdown">

                                        <i class="fa-solid fa-clock"></i>

                                        Attendance

                                    </a>

                                    <ul class="dropdown-menu">

                                        <!-- Everyone -->

                                        <li>

                                            <a asp-controller="Attendance"
                                            asp-action="TodayAttendance"
                                            class="dropdown-item">

                                                📅 Today's Attendance

                                            </a>

                                        </li>

                                        @if (isAdmin)
                                        {
                                            <li><hr class="dropdown-divider"></li>

                                            <li>

                                                <a asp-controller="Attendance"
                                                asp-action="Register"
                                                class="dropdown-item">

                                                    📋 Attendance Register

                                                </a>

                                            </li>

                                            <li>

                                                <a asp-controller="Attendance"
                                                asp-action="AttendanceCorrection"
                                                class="dropdown-item">

                                                    ✏️ Attendance Correction

                                                </a>

                                            </li>

                                            <li>

                                                <a class="dropdown-item disabled"
                                                href="#">

                                                    📊 Attendance Reports (Coming Soon)

                                                </a>

                                            </li>
                                        }

                                    </ul>

                                </li>

                                <!-- Leave Management -->

                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle"
                                    href="#"
                                    data-bs-toggle="dropdown">

                                        <i class="fa-solid fa-calendar-check"></i>

                                        Leave Management

                                    </a>

                                    <ul class="dropdown-menu">

                                        <!-- Everyone -->

                                        <li>

                                            <a asp-controller="Leave"
                                            asp-action="ApplyLeave"
                                            class="dropdown-item">

                                                📝 Apply Leave

                                            </a>

                                        </li>

                                        <li>

                                            <a asp-controller="Leave"
                                            asp-action="MyLeaveHistory"
                                            class="dropdown-item">

                                                📋 My Leave History

                                            </a>

                                        </li>

                                        @if (isAdmin || isTeamLeader || isManager)
                                        {
                                            <li><hr class="dropdown-divider"></li>

                                            @* Team Leader Approval *@
                                            @if (isAdmin || isTeamLeader)
                                            {
                                                <li>
                                                    <a asp-controller="LeaveApproval"
                                                    asp-action="Index"
                                                    class="dropdown-item">
                                                        ✔ Team Leader Leave Approval
                                                    </a>
                                                </li>
                                            }

                                            @* Manager Approval *@
                                            @if (isAdmin || isManager)
                                            {
                                                <li>
                                                    <a asp-controller="ManagerApproval"
                                                    asp-action="Index"
                                                    class="dropdown-item">
                                                        ✔ Manager Leave Approval
                                                    </a>
                                                </li>
                                            }

                                            <li>
                                                <a class="dropdown-item disabled" href="#">
                                                    📋 Leave Register (Coming Soon)
                                                </a>
                                            </li>

                                            <li>
                                                <a asp-controller="LeaveBalance"
                                                asp-action="Import"
                                                class="dropdown-item">
                                                    💰 Leave Balance Import
                                                </a>
                                            </li>

                                            <li><hr class="dropdown-divider"></li>

                                            <li>
                                                <a class="dropdown-item disabled" href="#">
                                                    🎉 Holiday Calendar (Coming Soon)
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item disabled" href="#">
                                                    ⏰ Permission Register (Coming Soon)
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item disabled" href="#">
                                                    📅 Payroll Calendar (Coming Soon)
                                                </a>
                                            </li>
                                        }

                                    </ul>

                                </li>

                                @if (isAdmin)
                                {
                                    <!-- Masters -->

                                    <li class="nav-item dropdown">

                                        <a class="nav-link dropdown-toggle"
                                        href="#"
                                        data-bs-toggle="dropdown">

                                            <i class="fa-solid fa-database"></i>

                                            Masters

                                        </a>

                                        <ul class="dropdown-menu">

                                            <li>

                                                <a asp-controller="Employee"
                                                asp-action="Index"
                                                class="dropdown-item">

                                                    👨 Employee Master

                                                </a>

                                            </li>

                                            <li>

                                                <a asp-controller="Department"
                                                asp-action="Index"
                                                class="dropdown-item">

                                                    🏢 Department Master

                                                </a>

                                            </li>

                                            <li>

                                                <a class="dropdown-item" href="#">

                                                    💼 Designation Master

                                                </a>

                                            </li>

                                            <li>

                                                <a asp-controller="Shift"
                                                asp-action="Index"
                                                class="dropdown-item">

                                                    🕒 Shift Master

                                                </a>

                                            </li>

                                            <li>

                                                <a class="dropdown-item" href="#">

                                                    📅 Leave Type Master

                                                </a>

                                            </li>

                                            <li>

                                                <a class="dropdown-item" href="#">

                                                    🎉 Holiday Master

                                                </a>

                                            </li>

                                        </ul>

                                    </li>

                                }

                                @if (isAdmin)
                                {
                                    <!-- Reports -->

                                    <li class="nav-item dropdown">

                                        <a class="nav-link dropdown-toggle"
                                        href="#"
                                        data-bs-toggle="dropdown">

                                            <i class="fa-solid fa-chart-column"></i>

                                            Reports

                                        </a>

                                        <ul class="dropdown-menu">

                                            <li><a class="dropdown-item" href="#">Attendance Report</a></li>

                                            <li><a class="dropdown-item" href="#">Employee Report</a></li>

                                            <li><a class="dropdown-item" href="#">Leave Report</a></li>

                                        </ul>

                                    </li>
                                }


                                @if (isAdmin)
                                {
                                    <!-- Administration -->

                                    <li class="nav-item dropdown">

                                        <a class="nav-link dropdown-toggle"
                                        href="#"
                                        data-bs-toggle="dropdown">

                                            <i class="fa-solid fa-gear"></i>

                                            Administration

                                        </a>

                                        <ul class="dropdown-menu">

                                            <li><a class="dropdown-item" href="#">Users</a></li>

                                            <li><a class="dropdown-item" href="#">Roles</a></li>

                                            <li><a class="dropdown-item" href="#">Company Settings</a></li>

                                            <li><a class="dropdown-item" href="#">Audit Logs</a></li>

                                        </ul>

                                    </li>
                                }

                            </ul>

                        </div>

                    </div>

                </nav>
            }
        }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>

    @await Html.PartialAsync("_FlashScripts")

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
