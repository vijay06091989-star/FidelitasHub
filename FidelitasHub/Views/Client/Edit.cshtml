@model FidelitasHub.Models.Client

@{
    ViewData["Title"] = "Edit Client";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">
            <i class="fa-solid fa-pen-to-square"></i> Edit Client
        </h1>

        <p class="page-head__sub">
            Update client details and shift responsibilities
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Back
    </a>
</div>


<form asp-action="Edit" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ClientId" />


    <!-- ================================================== -->
    <!-- Client Information -->
    <!-- ================================================== -->

    <div class="table-card mb-3">

        <div class="p-3 border-bottom">
            <h5 class="mb-0">
                <i class="fa-solid fa-handshake me-2"></i>
                Client Information
            </h5>
        </div>

        <div class="p-3">

            <div class="row g-3">

                <!-- Client Code -->

                <div class="col-md-4">

                    <label asp-for="ClientCode" class="form-label">
                        Client Code
                    </label>

                    <input asp-for="ClientCode"
                           class="form-control" />

                    <span asp-validation-for="ClientCode"
                          class="text-danger">
                    </span>

                </div>


                <!-- Client Name -->

                <div class="col-md-8">

                    <label asp-for="ClientName" class="form-label">
                        Client Name
                    </label>

                    <input asp-for="ClientName"
                           class="form-control" />

                    <span asp-validation-for="ClientName"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================== -->
    <!-- General Shift -->
    <!-- ================================================== -->

    <div class="table-card mb-3">

        <div class="p-3 border-bottom">
            <h5 class="mb-0">
                <i class="fa-solid fa-sun me-2"></i>
                General Shift
            </h5>
        </div>

        <div class="p-3">

            <div class="row g-3">

                <!-- General Shift Manager -->

                <div class="col-md-6">

                    <label asp-for="GeneralShiftManagerId"
                           class="form-label">
                        Manager
                    </label>

                    <select asp-for="GeneralShiftManagerId"
                            asp-items="ViewBag.GeneralShiftManagers"
                            class="form-select">

                        <option value="">
                            -- Optional: Select Manager --
                        </option>

                    </select>

                    <span asp-validation-for="GeneralShiftManagerId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Team Leader - Billing -->

                <div class="col-md-6">

                    <label asp-for="GeneralShiftBillingTeamLeaderId"
                           class="form-label">
                        Team Leader - Billing
                    </label>

                    <select asp-for="GeneralShiftBillingTeamLeaderId"
                            asp-items="ViewBag.GeneralShiftBillingTeamLeaders"
                            class="form-select">

                        <option value="">
                            -- Optional: Select Team Leader --
                        </option>

                    </select>

                    <span asp-validation-for="GeneralShiftBillingTeamLeaderId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Team Leader - Posting -->

                <div class="col-md-6">

                    <label asp-for="GeneralShiftPostingTeamLeaderId"
                           class="form-label">
                        Team Leader - Posting
                    </label>

                    <select asp-for="GeneralShiftPostingTeamLeaderId"
                            asp-items="ViewBag.GeneralShiftPostingTeamLeaders"
                            class="form-select">

                        <option value="">
                            -- Optional: Select Team Leader --
                        </option>

                    </select>

                    <span asp-validation-for="GeneralShiftPostingTeamLeaderId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Team Leader - DM -->

                <div class="col-md-6">

                    <label asp-for="GeneralShiftDMTeamLeaderId"
                           class="form-label">
                        Team Leader - DM
                    </label>

                    <select asp-for="GeneralShiftDMTeamLeaderId"
                            asp-items="ViewBag.GeneralShiftDMTeamLeaders"
                            class="form-select">

                        <option value="">
                            -- Optional: Select Team Leader --
                        </option>

                    </select>

                    <span asp-validation-for="GeneralShiftDMTeamLeaderId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Team Leader - End to End -->

                <div class="col-md-6">

                    <label asp-for="GeneralShiftEndToEndTeamLeaderId"
                           class="form-label">
                        Team Leader - End to End
                    </label>

                    <select asp-for="GeneralShiftEndToEndTeamLeaderId"
                            asp-items="ViewBag.GeneralShiftEndToEndTeamLeaders"
                            class="form-select">

                        <option value="">
                            -- Optional: Select Team Leader --
                        </option>

                    </select>

                    <span asp-validation-for="GeneralShiftEndToEndTeamLeaderId"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================== -->
    <!-- US Shift -->
    <!-- ================================================== -->

    <div class="table-card mb-3">

        <div class="p-3 border-bottom">
            <h5 class="mb-0">
                <i class="fa-solid fa-moon me-2"></i>
                US Shift
            </h5>
        </div>

        <div class="p-3">

            <div class="row g-3">

                <!-- US Shift Manager -->

                <div class="col-md-6">

                    <label asp-for="USShiftManagerId"
                           class="form-label">
                        Manager
                    </label>

                    <select asp-for="USShiftManagerId"
                            asp-items="ViewBag.USShiftManagers"
                            class="form-select">

                        <option value="">
                            -- Optional: Select Manager --
                        </option>

                    </select>

                    <span asp-validation-for="USShiftManagerId"
                          class="text-danger">
                    </span>

                </div>


                <!-- US Shift Team Leader -->

                <div class="col-md-6">

                    <label asp-for="USShiftTeamLeaderId"
                           class="form-label">
                        Team Leader
                    </label>

                    <select asp-for="USShiftTeamLeaderId"
                            asp-items="ViewBag.USShiftTeamLeaders"
                            class="form-select">

                        <option value="">
                            -- Optional: Select Team Leader --
                        </option>

                    </select>

                    <span asp-validation-for="USShiftTeamLeaderId"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================== -->
    <!-- Status -->
    <!-- ================================================== -->

    <div class="table-card mb-3">

        <div class="p-3 border-bottom">
            <h5 class="mb-0">
                <i class="fa-solid fa-toggle-on me-2"></i>
                Status
            </h5>
        </div>

        <div class="p-3">

            <div class="form-check form-switch">

                <input asp-for="IsActive"
                       class="form-check-input"
                       role="switch" />

                <label asp-for="IsActive"
                       class="form-check-label">
                    Active Client
                </label>

            </div>

        </div>

    </div>


    <!-- ================================================== -->
    <!-- Actions -->
    <!-- ================================================== -->

    <div class="d-flex justify-content-end gap-2 mb-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-xmark me-1"></i>
            Cancel

        </a>

        <button type="submit"
                class="btn btn-primary">

            <i class="fa-solid fa-floppy-disk me-1"></i>
            Save Changes

        </button>

    </div>

</form>


@{
    var currentSop = ViewBag.CurrentSop as FidelitasHub.Models.ClientSopDocument;
    var sopDocuments = ViewBag.SopDocuments as IEnumerable<FidelitasHub.Models.ClientSopDocument>
        ?? Enumerable.Empty<FidelitasHub.Models.ClientSopDocument>();
}


<!-- ================================================== -->
<!-- SOP Management -->
<!-- ================================================== -->

<div class="table-card mb-3">

    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">

        <div>
            <h5 class="mb-0">
                <i class="fa-solid fa-book me-2"></i>
                SOP Management
            </h5>

            <div class="text-muted small mt-1">
                Upload and maintain version-controlled SOP documents for this client.
            </div>
        </div>

        @if (currentSop != null)
        {
            <span class="badge text-bg-success px-3 py-2">
                Current: Version @currentSop.Version
            </span>
        }
        else
        {
            <span class="badge text-bg-secondary px-3 py-2">
                No SOP Uploaded
            </span>
        }

    </div>


    <div class="p-3">

        <!-- Upload New Version -->

        <form asp-action="UploadSop"
              method="post"
              enctype="multipart/form-data"
              class="mb-4">

            @Html.AntiForgeryToken()

            <input type="hidden" name="clientId" value="@Model.ClientId" />

            <div class="row g-3 align-items-end">

                <div class="col-md-8">

                    <label for="sopFile" class="form-label">
                        Upload New SOP Version
                    </label>

                    <input type="file"
                           id="sopFile"
                           name="sopFile"
                           accept="application/pdf,.pdf"
                           class="form-control"
                           required />

                    <div class="form-text">
                        PDF only. Maximum file size: 25 MB. The system automatically assigns the next version number.
                    </div>

                </div>

                <div class="col-md-4 d-grid">

                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-upload me-1"></i>
                        Upload New Version
                    </button>

                </div>

            </div>

        </form>


        @if (currentSop != null)
        {
            <!-- Current SOP -->

            <div class="border rounded p-3 mb-4">

                <div class="row g-3 align-items-center">

                    <div class="col-md-8">

                        <div class="text-muted small">
                            Current SOP
                        </div>

                        <div class="fw-semibold mb-2">
                            <i class="fa-solid fa-file-pdf text-danger me-1"></i>
                            @currentSop.DisplayFileName
                        </div>

                        <div class="row g-2 small">

                            <div class="col-md-4">
                                <span class="text-muted">Version:</span>
                                <strong>Version @currentSop.Version</strong>
                            </div>

                            <div class="col-md-4">
                                <span class="text-muted">Uploaded By:</span>
                                <strong>@currentSop.UploadedBy</strong>
                            </div>

                            <div class="col-md-4">
                                <span class="text-muted">Uploaded On:</span>
                                <strong>@currentSop.UploadedOn.ToString("dd-MMM-yyyy hh:mm tt")</strong>
                            </div>

                        </div>

                    </div>

                    <div class="col-md-4 text-md-end">

                        <a asp-action="ViewSop"
                           asp-route-id="@currentSop.ClientSopDocumentId"
                           target="_blank"
                           class="btn btn-outline-primary">

                            <i class="fa-solid fa-eye me-1"></i>
                            View Current SOP

                        </a>

                    </div>

                </div>

            </div>
        }


        <!-- Version History -->

        @if (sopDocuments.Any())
        {
            <h6 class="mb-3">
                <i class="fa-solid fa-clock-rotate-left me-1"></i>
                Version History
            </h6>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Version</th>
                            <th>Document</th>
                            <th>Uploaded By</th>
                            <th>Uploaded Date &amp; Time</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var sop in sopDocuments)
                        {
                            <tr>
                                <td>
                                    <strong>Version @sop.Version</strong>
                                </td>

                                <td>@sop.DisplayFileName</td>

                                <td>@sop.UploadedBy</td>

                                <td>@sop.UploadedOn.ToString("dd-MMM-yyyy hh:mm tt")</td>

                                <td>
                                    @if (sop.IsCurrent)
                                    {
                                        <span class="badge text-bg-success">Current</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Archived</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="ViewSop"
                                       asp-route-id="@sop.ClientSopDocumentId"
                                       target="_blank"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="fa-solid fa-eye me-1"></i>
                                        View

                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center text-muted py-3">
                No SOP has been uploaded for this client yet.
            </div>
        }

    </div>

</div>


@{
    var webLogins = ViewBag.WebLogins as IEnumerable<FidelitasHub.Models.ClientWebLogin>
        ?? Enumerable.Empty<FidelitasHub.Models.ClientWebLogin>();
}


<!-- ================================================== -->
<!-- Web Portal Logins -->
<!-- ================================================== -->

<div class="table-card mb-3">

    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">

        <div>
            <h5 class="mb-0">
                <i class="fa-solid fa-key me-2"></i>
                Web Portal Logins
            </h5>

            <div class="text-muted small mt-1">
                Maintain client portal and website login information.
                Passwords and security answers are stored encrypted.
            </div>
        </div>

        <a asp-action="CreateWebLogin"
           asp-route-clientId="@Model.ClientId"
           class="btn btn-primary btn-sm">

            <i class="fa-solid fa-plus me-1"></i>
            Add Web Login

        </a>

    </div>


    <div class="p-3">

        @if (webLogins.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Website / Portal</th>
                            <th>URL</th>
                            <th>User Name</th>
                            <th>Password</th>
                            <th>Security Questions</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var login in webLogins)
                        {
                            <tr>
                                <td>
                                    <strong>@login.Website</strong>
                                </td>

                                <td>
                                    <a href="@login.Url"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
                                        Open
                                    </a>
                                </td>

                                <td>@login.Username</td>

                                <td>
                                    <span class="text-muted">••••••••</span>
                                </td>

                                <td>
                                    <span class="text-muted">••••••••</span>
                                </td>

                                <td class="text-end text-nowrap">

                                    <a asp-action="EditWebLogin"
                                       asp-route-id="@login.ClientWebLoginId"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Edit">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>

                                    <form asp-action="DeleteWebLogin"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this web portal login?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@login.ClientWebLoginId" />

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                title="Delete">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </form>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center text-muted py-3">
                No web portal logins have been added for this client yet.
            </div>
        }

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}