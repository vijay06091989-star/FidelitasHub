@model FidelitasHub.Models.ClientWebLoginViewModel

@{
    ViewData["Title"] = "Add Web Portal Login";
}

<div class="page-head">

    <div>
        <h1 class="page-head__title">
            <i class="fa-solid fa-key"></i>
            Add Web Portal Login
        </h1>

        <p class="page-head__sub">
            @Model.ClientName
        </p>
    </div>

    <a asp-action="Edit"
       asp-route-id="@Model.ClientId"
       class="btn btn-outline-secondary">

        <i class="fa-solid fa-arrow-left me-1"></i>
        Back to Client

    </a>

</div>


<form asp-action="CreateWebLogin"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="ClientId" />

    <div class="table-card mb-3">

        <div class="p-3 border-bottom">
            <h5 class="mb-0">
                <i class="fa-solid fa-globe me-2"></i>
                Web Portal Details
            </h5>
        </div>

        <div class="p-3">

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="Website"
                           class="form-label">
                        Website / Portal
                    </label>

                    <input asp-for="Website"
                           class="form-control"
                           placeholder="Example: Palmetto GBA" />

                    <span asp-validation-for="Website"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Url"
                           class="form-label">
                        URL Link
                    </label>

                    <input asp-for="Url"
                           class="form-control"
                           placeholder="https://..." />

                    <span asp-validation-for="Url"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Username"
                           class="form-label">
                        User Name
                    </label>

                    <input asp-for="Username"
                           class="form-control" />

                    <span asp-validation-for="Username"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Password"
                           class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-12">

                    <label asp-for="SecurityQuestions"
                           class="form-label">
                        Security Questions
                    </label>

                    <textarea asp-for="SecurityQuestions"
                              class="form-control"
                              rows="5"
                              placeholder="Enter security questions and answers, if applicable."></textarea>

                    <span asp-validation-for="SecurityQuestions"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <div class="d-flex justify-content-end gap-2 mb-4">

        <a asp-action="Edit"
           asp-route-id="@Model.ClientId"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-xmark me-1"></i>
            Cancel

        </a>

        <button type="submit"
                class="btn btn-primary">

            <i class="fa-solid fa-floppy-disk me-1"></i>
            Save Login

        </button>

    </div>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
