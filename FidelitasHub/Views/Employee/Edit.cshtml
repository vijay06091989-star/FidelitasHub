@model FidelitasHub.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="page-head">

    <div>
        <h1 class="page-head__title">
            <i class="fa-solid fa-user-pen"></i>
            Edit Employee
        </h1>

        <p class="page-head__sub">
            Update employee details
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
        Back
    </a>

</div>


<div class="row">

    <div class="col-xl-10">

        <div class="fh-card">

            <div class="card-header d-flex align-items-center gap-2">

                <i class="fa-solid fa-id-card text-primary"></i>
                Employee Information

            </div>


            <div class="card-body">

                <form asp-action="Edit" method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="EmployeeId" type="hidden" />
                    <input asp-for="Password" type="hidden" />
                    <input asp-for="IsActive" type="hidden" />


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="row g-3">


                        <div class="col-md-6">

                            <label asp-for="EmployeeCode"
                                   class="form-label"></label>

                            <input asp-for="EmployeeCode"
                                   class="form-control" />

                            <span asp-validation-for="EmployeeCode"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="EmployeeName"
                                   class="form-label"></label>

                            <input asp-for="EmployeeName"
                                   class="form-control" />

                            <span asp-validation-for="EmployeeName"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Department"
                                   class="form-label"></label>

                            <select asp-for="Department"
                                    asp-items="ViewBag.Departments"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Department"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Designation"
                                   class="form-label"></label>

                            <input asp-for="Designation"
                                   class="form-control" />

                            <span asp-validation-for="Designation"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Email"
                                   class="form-label"></label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Mobile"
                                   class="form-label"></label>

                            <input asp-for="Mobile"
                                   class="form-control" />

                            <span asp-validation-for="Mobile"
                                  class="text-danger"></span>

                        </div>


                        <!-- ROLE -->

                        <div class="col-md-4">

                            <label asp-for="Role"
                                   class="form-label">
                                Role
                            </label>

                            <select asp-for="Role"
                                    class="form-select">

                                <option value="">
                                    -- Select Role --
                                </option>

                                <option value="Employee">
                                    Employee
                                </option>

                                <option value="Team Leader">
                                    Team Leader
                                </option>

                                <option value="Manager">
                                    Manager
                                </option>

                                <option value="Admin">
                                    Admin
                                </option>

                                <option value="SuperAdmin">
                                    SuperAdmin
                                </option>

                                <option value="Viewer">
                                    Viewer
                                </option>

                                <option value="Editor">
                                    Editor
                                </option>

                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger"></span>

                        </div>


                        <!-- SHIFT -->

                        <div class="col-md-4" id="shiftSection">

                            <label asp-for="ShiftId"
                                   class="form-label">
                                Shift
                            </label>

                            <select asp-for="ShiftId"
                                    asp-items="ViewBag.Shifts"
                                    class="form-select">

                                <option value="">
                                    -- Select Shift --
                                </option>

                            </select>

                            <span asp-validation-for="ShiftId"
                                  class="text-danger"></span>

                        </div>


                        <!-- DATE JOINED -->

                        <div class="col-md-4">

                            <label asp-for="DateJoined"
                                   class="form-label">
                            </label>

                            <input asp-for="DateJoined"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DateJoined"
                                  class="text-danger"></span>

                        </div>


                        <!-- REPORTING MANAGER -->

                        <div class="col-md-6"
                             id="reportingManagerSection">

                            <label asp-for="ReportingManagerId"
                                   class="form-label">
                                Reporting Manager
                            </label>

                            <select asp-for="ReportingManagerId"
                                    asp-items="ViewBag.ReportingManagers"
                                    class="form-select">

                                <option value="">
                                    -- Select Reporting Manager --
                                </option>

                            </select>

                            <span asp-validation-for="ReportingManagerId"
                                  class="text-danger"></span>

                        </div>


                        <!-- REPORTING TEAM LEADER -->

                        <div class="col-md-6"
                             id="reportingTeamLeaderSection">

                            <label asp-for="ReportingTeamLeaderId"
                                   class="form-label">
                                Reporting Team Leader
                            </label>

                            <select asp-for="ReportingTeamLeaderId"
                                    asp-items="ViewBag.ReportingTeamLeaders"
                                    class="form-select">

                                <option value="">
                                    -- Select Reporting Team Leader --
                                </option>

                            </select>

                            <span asp-validation-for="ReportingTeamLeaderId"
                                  class="text-danger"></span>

                        </div>


                        <!-- IDLE MONITORING -->

                        <div class="col-12">

                            <div class="form-check">

                                <input asp-for="EnableIdleMonitoring"
                                       class="form-check-input" />

                                <label asp-for="EnableIdleMonitoring"
                                       class="form-check-label">
                                    Enable Idle Activity Monitoring
                                </label>

                            </div>

                        </div>


                    </div>


                    <!-- PERSONAL & EMERGENCY DETAILS -->

                    <hr />

                    <div class="mb-3">
                        <h5 class="mb-1">
                            <i class="fa-solid fa-address-card text-primary me-1"></i>
                            Personal &amp; Emergency Details
                        </h5>
                        <p class="text-muted mb-0">Personal, identification and emergency contact information</p>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label"></label>
                            <input asp-for="Gender" class="form-control" />
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MaritalStatus" class="form-label"></label>
                            <input asp-for="MaritalStatus" class="form-control" />
                            <span asp-validation-for="MaritalStatus" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PANNumber" class="form-label"></label>
                            <input asp-for="PANNumber" class="form-control" />
                            <span asp-validation-for="PANNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="AadharNumber" class="form-label"></label>
                            <input asp-for="AadharNumber" class="form-control" />
                            <span asp-validation-for="AadharNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="BloodGroup" class="form-label"></label>
                            <input asp-for="BloodGroup" class="form-control" />
                            <span asp-validation-for="BloodGroup" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FatherName" class="form-label"></label>
                            <input asp-for="FatherName" class="form-control" />
                            <span asp-validation-for="FatherName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EmergencyContactPerson" class="form-label"></label>
                            <input asp-for="EmergencyContactPerson" class="form-control" />
                            <span asp-validation-for="EmergencyContactPerson" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EmergencyContactNumber" class="form-label"></label>
                            <input asp-for="EmergencyContactNumber" class="form-control" />
                            <span asp-validation-for="EmergencyContactNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PersonalEmail" class="form-label"></label>
                            <input asp-for="PersonalEmail" type="email" class="form-control" />
                            <span asp-validation-for="PersonalEmail" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="PermanentAddress" class="form-label"></label>
                            <textarea asp-for="PermanentAddress" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="PermanentAddress" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ResidentialAddress" class="form-label"></label>
                            <textarea asp-for="ResidentialAddress" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="ResidentialAddress" class="text-danger"></span>
                        </div>

                    </div>



                    <!-- =====================================================
                         EMPLOYEE DOCUMENTS
                         View / Download only - upload is done by the employee
                         from My Dashboard.
                         ===================================================== -->
                    <div class="fh-document-master mt-4 mb-4">
                        <div class="fh-document-master-head">
                            <div>
                                <div class="fh-document-master-title">
                                    <i class="fa-solid fa-folder-open me-2"></i>
                                    Employee Documents
                                </div>
                                <div class="fh-document-master-sub">
                                    Aadhaar and PAN copies uploaded by the employee.
                                </div>
                            </div>
                            <span class="badge text-bg-light" id="employeeDocumentSecurity">
                                PIN protected
                            </span>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <div class="fh-master-document-card">
                                    <div class="fh-master-document-icon">
                                        <i class="fa-solid fa-id-card"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold">Aadhaar Card</div>
                                        <div class="small text-muted" id="editAadhaarStatus">Checking...</div>
                                        <div class="d-flex gap-2 flex-wrap mt-2" id="editAadhaarActions"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="fh-master-document-card">
                                    <div class="fh-master-document-icon">
                                        <i class="fa-solid fa-address-card"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold">PAN Card</div>
                                        <div class="small text-muted" id="editPanStatus">Checking...</div>
                                        <div class="d-flex gap-2 flex-wrap mt-2" id="editPanActions"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <style>
                        .fh-document-master { padding:18px; border-radius:15px; border:1px solid rgba(148,163,184,.20); background:rgba(148,163,184,.045); }
                        .fh-document-master-head { display:flex; justify-content:space-between; align-items:center; gap:12px; }
                        .fh-document-master-title { font-weight:800; font-size:1rem; }
                        .fh-document-master-sub { font-size:.78rem; opacity:.62; margin-top:3px; }
                        .fh-master-document-card { display:flex; align-items:center; gap:13px; padding:15px; border-radius:13px; background:var(--bs-body-bg); border:1px solid rgba(148,163,184,.18); }
                        .fh-master-document-icon { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; background:rgba(14,165,233,.11); color:#0284c7; flex:0 0 auto; }
                    </style>

                    <hr />


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Update Employee

                    </button>


                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const roleSelect =
                document.getElementById("Role");

            const shiftSection =
                document.getElementById("shiftSection");

            const reportingManagerSection =
                document.getElementById("reportingManagerSection");

            const reportingTeamLeaderSection =
                document.getElementById("reportingTeamLeaderSection");


            function toggleSuperAdminFields() {

                const isSuperAdmin =
                    roleSelect.value === "SuperAdmin";

                const isProductivityOnly =
                    roleSelect.value === "Viewer" ||
                    roleSelect.value === "Editor";

                const hideEmployeeStructure =
                    isSuperAdmin || isProductivityOnly;


                shiftSection.style.display =
                    hideEmployeeStructure ? "none" : "";

                reportingManagerSection.style.display =
                    hideEmployeeStructure ? "none" : "";

                reportingTeamLeaderSection.style.display =
                    hideEmployeeStructure ? "none" : "";


                if (hideEmployeeStructure) {

                    document.getElementById("ShiftId").value = "";

                    document.getElementById(
                        "ReportingManagerId"
                    ).value = "";

                    document.getElementById(
                        "ReportingTeamLeaderId"
                    ).value = "";

                }

            }


            roleSelect.addEventListener(
                "change",
                toggleSuperAdminFields
            );



            toggleSuperAdminFields();

            //==================================================
            // Employee document status / View / Download
            //==================================================
            function loadEmployeeDocuments() {
                fetch('@Url.Action("Status", "EmployeeDocuments")?employeeId=@Model.EmployeeId', {
                    credentials: "same-origin"
                })
                .then(response => {
                    if (!response.ok) throw new Error("Document status unavailable");
                    return response.json();
                })
                .then(data => {
                    renderEmployeeDocument(
                        "Aadhaar",
                        "aadhaar",
                        data.aadhaarUploaded);
                    renderEmployeeDocument(
                        "Pan",
                        "pan",
                        data.panUploaded);
                })
                .catch(() => {
                    document.getElementById("editAadhaarStatus").textContent =
                        "PIN authorization expired or status unavailable.";
                    document.getElementById("editPanStatus").textContent =
                        "PIN authorization expired or status unavailable.";
                });
            }

            function renderEmployeeDocument(label, type, uploaded) {
                const status = document.getElementById("edit" + label + "Status");
                const actions = document.getElementById("edit" + label + "Actions");

                if (!status || !actions) return;

                actions.innerHTML = "";

                if (!uploaded) {
                    status.textContent = "Not uploaded by employee";
                    return;
                }

                status.textContent = "✓ Uploaded and available";

                const view = document.createElement("a");
                view.className = "btn btn-sm btn-outline-primary";
                view.href = '@Url.Action("ViewDocument", "EmployeeDocuments")' +
                    '?employeeId=@Model.EmployeeId&documentType=' + encodeURIComponent(type);
                view.target = "_blank";
                view.innerHTML = '<i class="fa-solid fa-eye me-1"></i> View';

                const download = document.createElement("a");
                download.className = "btn btn-sm btn-outline-secondary";
                download.href = '@Url.Action("DownloadDocument", "EmployeeDocuments")' +
                    '?employeeId=@Model.EmployeeId&documentType=' + encodeURIComponent(type);
                download.innerHTML = '<i class="fa-solid fa-download me-1"></i> Download';

                actions.appendChild(view);
                actions.appendChild(download);
            }

            loadEmployeeDocuments();

        });

    </script>
}