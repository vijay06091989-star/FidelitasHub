@model FidelitasHub.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
}


<div class="page-head">

    <div>
        <h1 class="page-head__title">
            <i class="fa-solid fa-user-pen"></i>
            Edit Employee
        </h1>

        <p class="page-head__sub">
            Update employee details
        </p>
    </div>


    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>
        Back
    </a>

</div>


<div class="row">

    <div class="col-xl-10">

        <div class="fh-card">

            <div class="card-header d-flex align-items-center gap-2">

                <i class="fa-solid fa-id-card text-primary"></i>
                Employee Information

            </div>


            <div class="card-body">


                <form asp-action="Edit" method="post">

                    @Html.AntiForgeryToken()


                    <input asp-for="EmployeeId" type="hidden" />
                    <input asp-for="Password" type="hidden" />
                    <input asp-for="IsActive" type="hidden" />


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="row g-3">


                        <div class="col-md-6">

                            <label asp-for="EmployeeCode"
                                   class="form-label"></label>

                            <input asp-for="EmployeeCode"
                                   class="form-control" />

                            <span asp-validation-for="EmployeeCode"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="EmployeeName"
                                   class="form-label"></label>

                            <input asp-for="EmployeeName"
                                   class="form-control" />

                            <span asp-validation-for="EmployeeName"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Department"
                                   class="form-label"></label>

                            <select asp-for="Department"
                                    asp-items="ViewBag.Departments"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Department"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Designation"
                                   class="form-label"></label>

                            <input asp-for="Designation"
                                   class="form-control" />

                            <span asp-validation-for="Designation"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Email"
                                   class="form-label"></label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="Mobile"
                                   class="form-label"></label>

                            <input asp-for="Mobile"
                                   class="form-control" />

                            <span asp-validation-for="Mobile"
                                  class="text-danger"></span>

                        </div>


                        <!-- ROLE -->

                        <div class="col-md-4">

                            <label asp-for="Role"
                                   class="form-label">
                                Role
                            </label>

                            <select asp-for="Role"
                                    class="form-select">

                                <option value="">
                                    -- Select Role --
                                </option>

                                <option value="Employee">
                                    Employee
                                </option>

                                <option value="Team Leader">
                                    Team Leader
                                </option>

                                <option value="Manager">
                                    Manager
                                </option>

                                <option value="Admin">
                                    Admin
                                </option>

                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger"></span>

                        </div>


                        <!-- SHIFT -->

                        <div class="col-md-4">

                            <label asp-for="ShiftId"
                                   class="form-label">
                                Shift
                            </label>

                            <select asp-for="ShiftId"
                                    asp-items="ViewBag.Shifts"
                                    class="form-select">

                                <option value="">
                                    -- Select Shift --
                                </option>

                            </select>

                            <span asp-validation-for="ShiftId"
                                  class="text-danger"></span>

                        </div>


                        <!-- DATE JOINED -->

                        <div class="col-md-4">

                            <label asp-for="DateJoined"
                                   class="form-label">
                            </label>

                            <input asp-for="DateJoined"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DateJoined"
                                  class="text-danger"></span>

                        </div>


                        <!-- REPORTING MANAGER -->

                        <div class="col-md-6">

                            <label asp-for="ReportingManagerId"
                                   class="form-label">
                                Reporting Manager
                            </label>

                            <select asp-for="ReportingManagerId"
                                    asp-items="ViewBag.ReportingManagers"
                                    class="form-select">

                                <option value="">
                                    -- Select Reporting Manager --
                                </option>

                            </select>

                            <span asp-validation-for="ReportingManagerId"
                                  class="text-danger"></span>

                        </div>


                        <!-- REPORTING TEAM LEADER -->

                        <div class="col-md-6">

                            <label asp-for="ReportingTeamLeaderId"
                                   class="form-label">
                                Reporting Team Leader
                            </label>

                            <select asp-for="ReportingTeamLeaderId"
                                    asp-items="ViewBag.ReportingTeamLeaders"
                                    class="form-select">

                                <option value="">
                                    -- Select Reporting Team Leader --
                                </option>

                            </select>

                            <span asp-validation-for="ReportingTeamLeaderId"
                                  class="text-danger"></span>

                        </div>


                    </div>


                    <hr />


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Update Employee

                    </button>


                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                </form>


            </div>


        </div>


    </div>


</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}