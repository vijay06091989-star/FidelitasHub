@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>@ViewBag.Subject</title>

    <style>

            body {
                margin: 0;
                padding: 40px;
                background: #f5f6fa;
                font-family: "Segoe UI", Arial, sans-serif;
            }

            .email-container {
                max-width: 800px;
                margin: auto;
                background: white;
                border-radius: 8px;
                box-shadow: 0 2px 10px rgba(0,0,0,.12);
                overflow: hidden;
            }

            .email-header {
                background: #0d6efd;
                color: white;
                padding: 20px 30px;
            }

                .email-header h2 {
                    margin: 0;
                    font-size: 24px;
                }

            .email-body {
                padding: 30px;
                line-height: 1.7;
                color: #333;
            }

            .email-footer {
                padding: 15px 30px;
                background: #f8f9fa;
                color: #666;
                font-size: 13px;
                border-top: 1px solid #ddd;
            }

    </style>

</head>

<body>

    <div class="email-container">

        <div class="email-header">

            <h2>@ViewBag.Subject</h2>

        </div>

        <div class="email-body">

            @Html.Raw(ViewBag.Body)

        </div>

        <div class="email-footer">

            This is a preview generated by Fidelitas Hub.

        </div>

    </div>

</body>

</html>