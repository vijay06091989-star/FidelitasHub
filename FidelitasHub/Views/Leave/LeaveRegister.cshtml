@model IEnumerable<FidelitasHub.Models.LeaveApplication>

@{
    ViewData["Title"] = "Leave Register";
    var names = ViewBag.EmployeeNames as Dictionary<int, string> ?? new Dictionary<int, string>();

    Func<string, string> badge = s =>
    {
        var v = (s ?? "").ToLower();
        if (v.Contains("approve")) return "badge-soft-success";
        if (v.Contains("reject")) return "badge-soft-danger";
        return "badge-soft-warning";
    };
}

<div class="page-head">
    <div>
        <h1 class="page-head__title"><i class="fa-solid fa-list-check"></i> Leave Register</h1>
        <p class="page-head__sub">All leave applications</p>
    </div>
</div>

<div class="stat-grid">
    <a class="stat @(string.IsNullOrEmpty(ViewBag.Status as string) ? "is-active" : "")" asp-action="LeaveRegister">
        <span class="stat__icon"><i class="fa-solid fa-list"></i></span>
        <div class="stat__body"><p class="stat__label">Total</p><p class="stat__value">@ViewBag.Total</p></div>
    </a>
    <a class="stat stat--warning @(ViewBag.Status == "Pending" ? "is-active" : "")" asp-action="LeaveRegister" asp-route-status="Pending">
        <span class="stat__icon"><i class="fa-solid fa-hourglass-half"></i></span>
        <div class="stat__body"><p class="stat__label">Pending</p><p class="stat__value">@ViewBag.Pending</p></div>
    </a>
    <a class="stat stat--success @(ViewBag.Status == "Approved" ? "is-active" : "")" asp-action="LeaveRegister" asp-route-status="Approved">
        <span class="stat__icon"><i class="fa-solid fa-circle-check"></i></span>
        <div class="stat__body"><p class="stat__label">Approved</p><p class="stat__value">@ViewBag.Approved</p></div>
    </a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Employee</th><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Applied</th><th>Status</th></tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var l in Model)
                    {
                        <tr>
                            <td>@(names.TryGetValue(l.EmployeeId, out var n) ? n : ("#" + l.EmployeeId))</td>
                            <td>@l.LeaveType</td>
                            <td>@l.FromDate.ToString("dd-MMM-yyyy")</td>
                            <td>@l.ToDate.ToString("dd-MMM-yyyy")</td>
                            <td>@l.TotalDays</td>
                            <td>@l.AppliedOn.ToString("dd-MMM-yyyy")</td>
                            <td><span class="badge @badge(l.Status)">@l.Status</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4"><i class="fa-solid fa-inbox fa-lg d-block mb-2"></i>No leave applications found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
