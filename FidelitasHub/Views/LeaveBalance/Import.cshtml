@model FidelitasHub.Models.LeaveBalanceImportViewModel

@{
    ViewData["Title"] = "Leave Balance Import";

    bool hasInvalidEmployee =
        Model.PreviewData.Any(x => x.Status == "Employee Not Found");
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">
            <i class="fa-solid fa-file-import"></i>
            Leave Balance Import
        </h1>

        <p class="page-head__sub">
            Upload an Excel file to bulk-update leave balances
        </p>
    </div>
</div>


<div class="row">
    <div class="col-xl-9">

        <div class="fh-card">

            <div class="card-header d-flex align-items-center gap-2">
                <i class="fa-solid fa-file-excel text-primary"></i>
                Upload File
            </div>


            <div class="card-body">

                <form asp-action="Import"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()


                    <div class="mb-3">

                        <label class="form-label">
                            Select Payroll Cycle
                        </label>


                        <select asp-for="PayrollCalendarId"
                                class="form-select">

                            <option value="">
                                -- Select Payroll Cycle --
                            </option>


                            @foreach (var cycle in Model.PayrollCycles)
                            {
                                <option value="@cycle.PayrollCalendarId">

                                    @cycle.PayrollMonth

                                    (
                                    @cycle.PeriodStart.ToString("dd-MMM-yyyy")
                                    to
                                    @cycle.PeriodEnd.ToString("dd-MMM-yyyy")
                                    )

                                </option>
                            }

                        </select>


                        <span asp-validation-for="PayrollCalendarId"
                              class="text-danger">
                        </span>

                    </div>



                    <div class="mb-3">

                        <label class="form-label">
                            Select Excel File
                        </label>


                        <input asp-for="ExcelFile"
                               type="file"
                               class="form-control"
                               accept=".xlsx,.xls" />


                        <span asp-validation-for="ExcelFile"
                              class="text-danger">
                        </span>


                        <div class="form-text">
                            Accepted formats: .xlsx, .xls
                        </div>

                    </div>



                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-magnifying-glass me-1"></i>

                        Preview Excel

                    </button>


                </form>


            </div>

        </div>



        @if (Model.PreviewData != null &&
             Model.PreviewData.Any())
        {

            <div class="fh-card mt-4">


                <div class="card-header d-flex align-items-center gap-2">

                    <i class="fa-solid fa-table-list text-primary"></i>

                    Excel Preview

                </div>



                <div class="card-body">


                    @if (hasInvalidEmployee)
                    {

                        <div class="alert alert-warning">

                            <i class="fa-solid fa-triangle-exclamation"></i>

                            <strong>
                                Import blocked.
                            </strong>

                            One or more employee codes were not found.

                        </div>

                    }



                    <div class="table-card">

                        <div class="table-responsive">


                            <table class="table table-hover mb-0">


                                <thead>

                                    <tr>

                                        <th>
                                            Employee Code
                                        </th>


                                        <th>
                                            Employee Name
                                        </th>


                                        <th class="text-end">
                                            Leave Balance
                                        </th>


                                        <th>
                                            Status
                                        </th>


                                    </tr>

                                </thead>



                                <tbody>


                                    @foreach (var item in Model.PreviewData)
                                    {

                                        <tr>


                                            <td>
                                                @item.EmployeeCode
                                            </td>


                                            <td>
                                                @item.EmployeeName
                                            </td>


                                            <td class="text-end">
                                                @item.LeaveBalance
                                            </td>


                                            <td>

                                                @if (item.Status == "Employee Found")
                                                {

                                                    <span class="badge badge-soft-success">
                                                        Found
                                                    </span>

                                                }
                                                else
                                                {

                                                    <span class="badge badge-soft-danger">
                                                        Not Found
                                                    </span>

                                                }

                                            </td>


                                        </tr>

                                    }


                                </tbody>


                            </table>


                        </div>

                    </div>



                    <form asp-action="SaveImport"
                          method="post"
                          class="mt-3">


                        @Html.AntiForgeryToken()


                        <input type="hidden"
                               asp-for="PayrollCalendarId" />



                        <button type="submit"
                                class="btn btn-primary btn-lg"
                            @(hasInvalidEmployee ? "disabled" : "")>


                            <i class="fa-solid fa-database me-1"></i>

                            Import Leave Balances


                        </button>


                    </form>


                </div>


            </div>

        }


    </div>

</div>



@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}