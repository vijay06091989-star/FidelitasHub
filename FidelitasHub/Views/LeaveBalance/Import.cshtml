@model FidelitasHub.Models.LeaveBalanceImportViewModel

@{
    ViewData["Title"] = "Leave Balance Import";

    bool hasInvalidEmployee = Model.PreviewData.Any(x => x.Status == "Employee Not Found");
}

<div class="container-fluid mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">
                📥 Leave Balance Import
            </h3>

        </div>

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="Import"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Select Excel File
                    </label>

                    <input asp-for="ExcelFile"
                           type="file"
                           class="form-control"
                           accept=".xlsx,.xls" />

                    <span asp-validation-for="ExcelFile"
                          class="text-danger"></span>

                </div>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa-solid fa-upload"></i>

                    Preview Excel

                </button>

            </form>

        </div>

    </div>

</div>

@if (Model.PreviewData != null && Model.PreviewData.Any())
{
    <div class="card shadow mt-4">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">
                Excel Preview
            </h5>

        </div>

        <div class="card-body">

            <table class="table table-bordered table-striped table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Employee Code</th>
                        <th>Employee Name</th>
                        <th class="text-end">Leave Balance</th>
                        <th>Status</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.PreviewData)
                    {
                        <tr>

                            <td>@item.EmployeeCode</td>

                            <td>@item.EmployeeName</td>

                            <td class="text-end">
                                @item.LeaveBalance
                            </td>

                            <td>

                                @if (item.Status == "Employee Found")
                                {
                                    <span class="badge bg-success">
                                        ✓ Employee Found
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        ✗ Employee Not Found
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <hr />

            @if (hasInvalidEmployee)
            {
                <div class="alert alert-warning">

                    <strong>Import Blocked.</strong>

                    One or more employee codes were not found.

                    Please correct the Excel file and preview again.

                </div>
            }

            <form asp-action="SaveImport" method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success btn-lg"
                    @(hasInvalidEmployee ? "disabled" : "")>

                    <i class="fa-solid fa-database"></i>

                    Import Leave Balances

                </button>

            </form>

        </div>

    </div>
}

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}