@model FidelitasHub.Models.ProductivitySetupViewModel
@{ ViewData["Title"] = "Productivity Setup"; }
<div class="page-head"><div><h1 class="page-head__title"><i class="fa-solid fa-sliders"></i> Productivity Setup</h1><p class="page-head__sub">Configure processes, activities, employee groups, targets and client scope.</p></div></div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row g-4">
<div class="col-lg-4">
<div class="table-card"><div class="p-3 border-bottom"><h5 class="mb-0">1. Add Process</h5></div><form asp-action="CreateProcess" method="post" class="p-3">
<div class="mb-3"><label class="form-label">Client Scope</label><select name="clientId" class="form-select" required><option value="0">ALL CLIENTS</option>@foreach(var c in Model.Clients){<option value="@c.ClientId">@c.ClientCode - @c.ClientName</option>}</select><div class="form-text">ALL CLIENTS is a global process scope and is not counted as an additional client.</div></div>
<div class="mb-3"><label class="form-label">Process Code</label><input name="processCode" class="form-control" maxlength="30" required /></div>
<div class="mb-3"><label class="form-label">Process Name</label><input name="processName" class="form-control" maxlength="150" required /></div>
<div class="mb-3"><label class="form-label">Department</label><select name="departmentId" class="form-select"><option value="">Not specified</option>@foreach(var d in Model.Departments){<option value="@d.DepartmentId">@d.DepartmentName</option>}</select></div>
<button class="btn btn-primary w-100"><i class="fa-solid fa-plus me-1"></i> Add Process</button></form></div>
<div class="table-card mt-4"><div class="p-3 border-bottom"><h5 class="mb-0">2. Add Activity</h5></div><form asp-action="CreateActivity" method="post" class="p-3">
<div class="mb-3"><label class="form-label">Process</label><select name="processId" class="form-select" required><option value="">Select process</option>@foreach(var p in Model.Processes){<option value="@p.ProductivityProcessId" selected="@(Model.SelectedProcessId == p.ProductivityProcessId)">@(p.Client == null ? "ALL CLIENTS" : p.Client.ClientCode) - @p.ProcessName</option>}</select></div>
<div class="mb-3"><label class="form-label">Activity Code</label><input name="activityCode" class="form-control" required /></div>
<div class="mb-3"><label class="form-label">Activity Name</label><input name="activityName" class="form-control" required /></div>
<div class="mb-3"><label class="form-label">Unit</label><input name="unit" class="form-control" value="Count" required /></div>
<div class="mb-3"><label class="form-label">Measurement Method</label><input name="measurementMethod" class="form-control" placeholder="Optional" /></div>
<div class="row g-2"><div class="col-6"><label class="form-label">Default Target / Day</label><input name="defaultTargetPerDay" type="number" step="0.01" min="0" class="form-control" value="0" /></div><div class="col-6"><label class="form-label">Default Weight</label><input name="defaultWeight" type="number" step="0.0001" min="0.0001" class="form-control" value="1" /></div></div>
<button class="btn btn-primary w-100 mt-3"><i class="fa-solid fa-plus me-1"></i> Add Activity</button></form></div>
</div>

<div class="col-lg-8">
<div class="table-card"><div class="p-3 border-bottom"><h5 class="mb-0">3. Productivity Groups</h5><div class="text-muted small">Create a group once, then add many employees to it. The group can receive one activity configuration for one client or ALL CLIENTS.</div></div>
<form asp-action="CreateGroup" method="post" class="p-3"><div class="row g-3"><div class="col-md-5"><label class="form-label">Group Name</label><input name="groupName" class="form-control" maxlength="100" placeholder="e.g. DM Team A" required /></div><div class="col-md-5"><label class="form-label">Description</label><input name="description" class="form-control" maxlength="250" placeholder="Optional" /></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-success w-100"><i class="fa-solid fa-users me-1"></i> Create</button></div></div></form>
@if(Model.Groups.Any()) { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Group</th><th>Members</th><th>Description</th></tr></thead><tbody>@foreach(var g in Model.Groups){<tr><td><strong>@g.GroupName</strong></td><td>@g.Members.Count(x=>x.IsActive)</td><td>@g.Description</td></tr>}</tbody></table></div> }
</div>

<div class="table-card mt-4"><div class="p-3 border-bottom"><h5 class="mb-0">4. Add Employees to Group</h5><div class="text-muted small">Select multiple employees at once. No more one-by-one assignment.</div></div>
<form asp-action="SaveGroupMembers" method="post" class="p-3"><div class="row g-3"><div class="col-md-4"><label class="form-label">Group</label><select name="groupId" class="form-select" required><option value="">Select group</option>@foreach(var g in Model.Groups){<option value="@g.ProductivityGroupId">@g.GroupName</option>}</select></div><div class="col-md-8"><label class="form-label">Employees</label><select name="employeeIds" class="form-select" multiple size="7" required>@foreach(var e in Model.Employees){<option value="@e.EmployeeId">@e.EmployeeCode - @e.EmployeeName</option>}</select><div class="form-text">Use Ctrl-click to select multiple employees.</div></div><div class="col-md-4"><label class="form-label">Effective From</label><input name="effectiveFrom" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required /></div><div class="col-md-4"><label class="form-label">Effective To</label><input name="effectiveTo" type="date" class="form-control" /></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100"><i class="fa-solid fa-user-plus me-1"></i> Add Selected Employees</button></div></div></form>
@if(Model.GroupMembers.Any()) { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Group</th><th>Employee</th><th>Effective</th><th></th></tr></thead><tbody>@foreach(var m in Model.GroupMembers){<tr><td>@m.Group?.GroupName</td><td>@m.Employee?.EmployeeCode - @m.Employee?.EmployeeName</td><td>@m.EffectiveFrom.ToString("dd-MMM-yyyy") - @(m.EffectiveTo?.ToString("dd-MMM-yyyy") ?? "Open")</td><td><form asp-action="DeactivateGroupMember" method="post"><input type="hidden" name="id" value="@m.ProductivityGroupMemberId"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr>}</tbody></table></div> }
</div>

<div class="table-card mt-4"><div class="p-3 border-bottom"><h5 class="mb-0">5. Assign Activity to Group</h5><div class="text-muted small"><strong>ALL CLIENTS</strong> is a real global scope. One configuration applies to every active client without creating 56 separate assignments.</div></div>
<form asp-action="CreateGroupAssignment" method="post" class="p-3"><div class="row g-3"><div class="col-md-4"><label class="form-label">Group</label><select name="groupId" class="form-select" required><option value="">Select group</option>@foreach(var g in Model.Groups){<option value="@g.ProductivityGroupId">@g.GroupName</option>}</select></div><div class="col-md-4"><label class="form-label">Client Scope</label><select name="clientId" class="form-select" required><option value="0">ALL CLIENTS</option>@foreach(var c in Model.Clients){<option value="@c.ClientId">@c.ClientCode - @c.ClientName</option>}</select></div><div class="col-md-4"><label class="form-label">Activity</label><select name="activityId" class="form-select" required><option value="">Select activity</option>@foreach(var a in Model.Activities){<option value="@a.ProductivityActivityId">@(a.Process?.Client == null ? "ALL CLIENTS" : a.Process.Client.ClientCode) - @a.Process?.ProcessName - @a.ActivityName</option>}</select></div><div class="col-md-3"><label class="form-label">Target / Day</label><input name="targetPerDay" type="number" step="0.01" min="0" class="form-control" required /></div><div class="col-md-3"><label class="form-label">Weight</label><input name="weight" type="number" step="0.0001" min="0.0001" value="1" class="form-control" required /></div><div class="col-md-3"><label class="form-label">Effective From</label><input name="effectiveFrom" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required /></div><div class="col-md-3"><label class="form-label">Effective To</label><input name="effectiveTo" type="date" class="form-control" /></div></div><button class="btn btn-success mt-3"><i class="fa-solid fa-layer-group me-1"></i> Assign Activity to Group</button></form>
@if(Model.GroupAssignments.Any()) { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Group</th><th>Client Scope</th><th>Process</th><th>Activity</th><th>Target</th><th>Weight</th><th>Effective</th><th></th></tr></thead><tbody>@foreach(var a in Model.GroupAssignments){<tr><td>@a.Group?.GroupName</td><td>@(a.ClientId.HasValue ? a.Client?.ClientCode : "ALL CLIENTS")</td><td>@a.Activity?.Process?.ProcessName</td><td>@a.Activity?.ActivityName</td><td>@a.TargetPerDay.ToString("0.##")</td><td>@a.Weight.ToString("0.####")</td><td>@a.EffectiveFrom.ToString("dd-MMM-yyyy") - @(a.EffectiveTo?.ToString("dd-MMM-yyyy") ?? "Open")</td><td><form asp-action="DeactivateGroupAssignment" method="post"><input type="hidden" name="id" value="@a.ProductivityGroupAssignmentId"/><button class="btn btn-sm btn-outline-danger">Deactivate</button></form></td></tr>}</tbody></table></div> }
</div>

<div class="table-card mt-4"><div class="p-3 border-bottom"><h5 class="mb-0">6. Existing Individual Assignments</h5><div class="text-muted small">Kept as a detailed override. An individual assignment takes precedence over a group assignment for the same employee/client/activity.</div></div>
<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Employee</th><th>Client</th><th>Process</th><th>Activity</th><th>Target</th><th>Weight</th><th>Effective</th><th></th></tr></thead><tbody>@foreach(var a in Model.Assignments){<tr><td>@a.Employee?.EmployeeCode<br><span class="text-muted small">@a.Employee?.EmployeeName</span></td><td>@a.Client?.ClientCode</td><td>@a.Activity?.Process?.ProcessName</td><td>@a.Activity?.ActivityName</td><td>@a.TargetPerDay.ToString("0.##")</td><td>@a.Weight.ToString("0.####")</td><td>@a.EffectiveFrom.ToString("dd-MMM-yyyy")<br>@(a.EffectiveTo?.ToString("dd-MMM-yyyy") ?? "Open")</td><td><form asp-action="DeactivateAssignment" method="post"><input type="hidden" name="id" value="@a.ProductivityAssignmentId"/><button class="btn btn-sm btn-outline-danger">Deactivate</button></form></td></tr>}</tbody></table></div></div>
</div></div>

<div class="table-card mt-4"><div class="p-3 border-bottom"><h5 class="mb-0">Configured Processes & Activities</h5></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Client</th><th>Process</th><th>Department</th><th>Activities</th></tr></thead><tbody>@foreach(var p in Model.Processes){<tr><td>@(p.Client == null ? "ALL CLIENTS" : p.Client.ClientCode)</td><td><strong>@p.ProcessName</strong><br><span class="text-muted small">@p.ProcessCode</span></td><td>@p.Department?.DepartmentName</td><td>@foreach(var a in p.Activities.Where(x=>x.IsActive).OrderBy(x=>x.ActivityName)){<span class="badge text-bg-light border me-1 mb-1">@a.ActivityName · @a.Unit · @a.DefaultTargetPerDay.ToString("0.##")/day · ×@a.DefaultWeight.ToString("0.####")</span>}</td></tr>}</tbody></table></div></div>
