@{
    ViewData["Title"] = "Productivity Dashboard";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">
            <i class="fa-solid fa-chart-line"></i>
            Productivity Dashboard
        </h1>

        <p class="page-head__sub">
            Monitor productivity performance across clients and teams
        </p>
    </div>
</div>


<!-- ==================================================
     Productivity Statistics
================================================== -->

<div class="stat-grid">

    <div class="stat">
        <span class="stat__icon">
            <i class="fa-solid fa-handshake"></i>
        </span>

        <div class="stat__body">
            <p class="stat__label">Active Clients</p>
            <p class="stat__value">0</p>
        </div>
    </div>


    <div class="stat stat--success">
        <span class="stat__icon">
            <i class="fa-solid fa-users"></i>
        </span>

        <div class="stat__body">
            <p class="stat__label">Employees</p>
            <p class="stat__value">0</p>
        </div>
    </div>


    <div class="stat stat--danger">
        <span class="stat__icon">
            <i class="fa-solid fa-chart-column"></i>
        </span>

        <div class="stat__body">
            <p class="stat__label">Productivity Records</p>
            <p class="stat__value">0</p>
        </div>
    </div>

</div>


<!-- ==================================================
     Coming Soon / Setup Status
================================================== -->

<div class="table-card">

    <div class="p-4 text-center">

        <i class="fa-solid fa-chart-line fa-2x mb-3 text-muted"></i>

        <h4>Productivity Module</h4>

        <p class="text-muted mb-0">
            Productivity setup and reporting will appear here.
        </p>

    </div>

</div>