@model FidelitasHub.Models.ProductivityReportsViewModel
@{ ViewData["Title"] = "Productivity Reports"; }
<div class="page-head"><div><h1 class="page-head__title"><i class="fa-solid fa-chart-column"></i> Productivity Reports</h1><p class="page-head__sub">Target versus actual production using effective assignments and approved leave-adjusted working days.</p></div></div>
<div class="table-card mb-4"><form asp-action="Reports" method="get" class="p-3"><div class="row g-3"><div class="col-md-2"><label class="form-label">From</label><input name="fromDate" type="date" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" /></div><div class="col-md-2"><label class="form-label">To</label><input name="toDate" type="date" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" /></div><div class="col-md-3"><label class="form-label">Employee</label><select name="employeeId" class="form-select"><option value="">All</option>@foreach(var e in Model.Employees){<option value="@e.EmployeeId" selected="@(Model.EmployeeId==e.EmployeeId)">@e.EmployeeCode - @e.EmployeeName</option>}</select></div><div class="col-md-2"><label class="form-label">Client</label><select name="clientId" class="form-select"><option value="">All</option>@foreach(var c in Model.Clients){<option value="@c.ClientId" selected="@(Model.ClientId==c.ClientId)">@c.ClientCode</option>}</select></div><div class="col-md-3"><label class="form-label">Process</label><select name="processId" class="form-select"><option value="">All</option>@foreach(var p in Model.Processes){<option value="@p.ProductivityProcessId" selected="@(Model.ProcessId==p.ProductivityProcessId)">@p.ProcessName</option>}</select></div></div><div class="mt-3"><button class="btn btn-primary"><i class="fa-solid fa-filter me-1"></i> Run Report</button> <a class="btn btn-outline-success" href="@Url.Action("ExportReport", "Productivity", new { fromDate=Model.FromDate.ToString("yyyy-MM-dd"), toDate=Model.ToDate.ToString("yyyy-MM-dd"), employeeId=Model.EmployeeId, clientId=Model.ClientId, processId=Model.ProcessId })"><i class="fa-solid fa-file-csv me-1"></i> Export CSV</a></div></form></div>
<div class="table-card"><div class="p-3 border-bottom d-flex justify-content-between"><h5 class="mb-0">Report</h5><span class="badge text-bg-primary">@Model.Rows.Count row(s)</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Employee</th><th>Client</th><th>Process</th><th>Activity</th><th class="text-end">Target</th><th class="text-end">Actual</th><th class="text-end">Weighted</th><th class="text-end">Achieved %</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.EmployeeCode<br><span class="text-muted small">@r.EmployeeName</span></td><td>@r.ClientCode<br><span class="text-muted small">@r.ClientName</span></td><td>@r.ProcessName</td><td>@r.ActivityName</td><td class="text-end">@r.Target.ToString("0.##")</td><td class="text-end">@r.Actual.ToString("0.##")</td><td class="text-end">@r.WeightedAchievement.ToString("0.##")</td><td class="text-end">@r.AchievementPercent.ToString("0.00")%</td></tr>} @if(!Model.Rows.Any()){<tr><td colspan="8" class="text-center text-muted p-4">No production entries match the selected filters.</td></tr>}</tbody></table></div></div>
