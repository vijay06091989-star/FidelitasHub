@model IEnumerable<FidelitasHub.Models.Shift>

@{
    ViewData["Title"] = "Shift Master";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center">

        <h2 class="text-primary fw-bold">
            🕒 Shift Master
        </h2>

        <a asp-action="Create"
           class="btn btn-success">

            <i class="fa-solid fa-plus"></i>

            Add Shift

        </a>

    </div>

    <hr />

    <!-- ================= Dashboard ================= -->

    <div class="row mb-4">

        <div class="col-md-4">

            <a asp-action="Index"
               class="text-decoration-none">

                <div class="card shadow h-100 @(string.IsNullOrEmpty(ViewBag.Status) ? "border-4 border-primary" : "border-primary")">

                    <div class="card-body text-center">

                        <h6 class="text-muted">

                            Total Shifts

                        </h6>

                        <h2 class="text-primary fw-bold">

                            @ViewBag.TotalShifts

                        </h2>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-md-4">

            <a asp-action="Index"
               asp-route-status="Active"
               asp-route-searchText="@ViewBag.SearchText"
               class="text-decoration-none">

                <div class="card shadow h-100 @(ViewBag.Status=="Active" ? "border-4 border-success" : "border-success")">

                    <div class="card-body text-center">

                        <h6 class="text-muted">

                            Active Shifts

                        </h6>

                        <h2 class="text-success fw-bold">

                            @ViewBag.ActiveShifts

                        </h2>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-md-4">

            <a asp-action="Index"
               asp-route-status="Inactive"
               asp-route-searchText="@ViewBag.SearchText"
               class="text-decoration-none">

                <div class="card shadow h-100 @(ViewBag.Status=="Inactive" ? "border-4 border-danger" : "border-danger")">

                    <div class="card-body text-center">

                        <h6 class="text-muted">

                            Inactive Shifts

                        </h6>

                        <h2 class="text-danger fw-bold">

                            @ViewBag.InactiveShifts

                        </h2>

                    </div>

                </div>

            </a>

        </div>

    </div>
        <!-- ================= Search ================= -->

    <form asp-action="Index"
          method="get"
          class="row mb-4">

        <div class="col-md-4">

            <input type="text"
                   name="searchText"
                   value="@ViewBag.SearchText"
                   class="form-control"
                   placeholder="Search Shift..." />

        </div>

        <div class="col-md-3">

            <button type="submit"
                    class="btn btn-primary">

                <i class="fa-solid fa-magnifying-glass"></i>

                Search

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Clear

            </a>

        </div>

    </form>

    <!-- ================= Shift List ================= -->

    <table class="table table-bordered table-hover table-striped">

        <thead class="table-primary">

            <tr>

                <th width="120">Code</th>

                <th>Shift Name</th>

                <th width="220">Timing</th>

                <th width="120">DST</th>

                <th width="120">Status</th>

                <th width="220">Action</th>

            </tr>

        </thead>

        <tbody>

            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>

                        <td>

                            @item.ShiftCode

                        </td>

                        <td>

                            @item.ShiftName

                        </td>

                        <td>

                            @{
                                var start = DateTime.Today.Add(item.StandardStartTime)
                                    .ToString("hh:mm tt");

                                var end = DateTime.Today.Add(item.StandardEndTime)
                                    .ToString("hh:mm tt");
                            }

                            @start → @end

                        </td>

                        <td>

                            @if (item.DstApplicable)
                            {
                                <span class="badge bg-info">

                                    Yes

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">

                                    No

                                </span>
                            }

                        </td>

                        <td>

                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">

                                    Active

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">

                                    Inactive

                                </span>
                            }

                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.ShiftId"
                               class="btn btn-primary btn-sm">

                                <i class="fa-solid fa-pen"></i>

                                Edit

                            </a>

                            @if (item.IsActive)
                            {
                                <form id="disableForm_@item.ShiftId"
                                      asp-action="Disable"
                                      asp-route-id="@item.ShiftId"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            onclick="confirmDisable('@item.ShiftId','@item.ShiftName')">

                                        <i class="fa-solid fa-ban"></i>

                                        Disable

                                    </button>

                                </form>
                            }
                            else
                            {
                                <form id="enableForm_@item.ShiftId"
                                      asp-action="Enable"
                                      asp-route-id="@item.ShiftId"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="button"
                                            class="btn btn-success btn-sm"
                                            onclick="confirmEnable('@item.ShiftId','@item.ShiftName')">

                                        <i class="fa-solid fa-check"></i>

                                        Enable

                                    </button>

                                </form>
                            }

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="6"
                        class="text-center text-danger fw-bold">

                        No Shifts Found.

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@section Scripts
{
    <script>

        function confirmDisable(id, name)
        {
            Swal.fire({

                title: 'Disable Shift?',

                html:
                    '<b>' + name + '</b><br><br>' +
                    'This shift will become inactive.',

                icon: 'warning',

                showCancelButton: true,

                confirmButtonColor: '#dc3545',

                cancelButtonColor: '#6c757d',

                confirmButtonText: 'Yes, Disable',

                cancelButtonText: 'Cancel'

            }).then((result) => {

                if (result.isConfirmed)
                {
                    document.getElementById('disableForm_' + id).submit();
                }

            });
        }

        function confirmEnable(id, name)
        {
            Swal.fire({

                title: 'Enable Shift?',

                html:
                    '<b>' + name + '</b><br><br>' +
                    'This shift will become active again.',

                icon: 'question',

                showCancelButton: true,

                confirmButtonColor: '#198754',

                cancelButtonColor: '#6c757d',

                confirmButtonText: 'Yes, Enable',

                cancelButtonText: 'Cancel'

            }).then((result) => {

                if (result.isConfirmed)
                {
                    document.getElementById('enableForm_' + id).submit();
                }

            });
        }

    </script>
}